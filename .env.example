APP_ENV=LOCAL
APP_PORT=:8000
LOG_LEVEL=debug
PPROF_ADDR=
DATABASE_URL=postgres://loco_user:loco_password@localhost:5432/loco?sslmode=disable
CACHE_TYPE=valkey
CACHE_ADDR=valkey://127.0.0.1:6379
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_PLATFORM_DOMAIN=onloco.app
MIN_CLI_VERSION=
AGENT_TOKEN=loco-dev-agent-token

LOCO_REGISTRY_HOST=loco-registry:5000
LOCO_REGISTRY_PREFIX=
LOCO_REGISTRY_URL=http://localhost:5001
LOCO_REGISTRY_USERNAME=api
LOCO_REGISTRY_PASSWORD=loco-dev-api
LOCO_REGISTRY_TIMEOUT=
# 0 disables Loco's image cleanup, for registries with their own lifecycle rules
LOCO_IMAGE_RETENTION=
LOCO_IMAGE_SWEEP_INTERVAL=
LOCO_IMAGE_SWEEP_BUILD_BATCH=
LOCO_IMAGE_SWEEP_REPOSITORY_BATCH=
LOCO_IMAGE_SWEEP_TAG_BATCH=
LOCO_IMAGE_SWEEP_TAG_MIN_AGE=
LOCO_SOURCE_SWEEP_INTERVAL=
LOCO_SOURCE_SWEEP_UPLOAD_GRACE=
LOCO_SOURCE_SWEEP_ORPHAN_MIN_AGE=
LOCO_SOURCE_SWEEP_BUILD_BATCH=
LOCO_SOURCE_SWEEP_ORPHAN_PAGE_SIZE=
LOCO_SOURCE_SWEEP_ORPHAN_MAX_PAGES=
LOCO_SOURCE_BUCKET_ENDPOINT=http://loco-s3.localhost:9000
LOCO_SOURCE_BUCKET=loco-sources
LOCO_SOURCE_BUCKET_REGION=us-east-1
LOCO_SOURCE_BUCKET_ACCESS_KEY_ID=loco-dev
LOCO_SOURCE_BUCKET_SECRET_ACCESS_KEY=loco-dev-secret
LOCO_SOURCE_BUCKET_FORCE_PATH_STYLE=true
LOCO_SOURCE_MAX_BYTES=209715200

GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

WEB_URL=http://localhost:5173
AUTH_ISSUERS='[{"issuer":"http://localhost:5556/dex","audience":"loco","emailVerification":"claim","web":{"clientId":"loco","scopes":"openid email profile offline_access"}}]'
AUTH_SIGNUP_MODE=open
AUTH_SIGNUP_DOMAINS=
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
INSTALL_WEBHOOKS=
EVENTS_RETENTION_DAYS=

CERT_MANAGER_EMAIL=dev@example.com
CLOUDFLARE_TOKEN=
GRAFANA_ADMIN_PASSWORD=admin
