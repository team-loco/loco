APP_ENV=LOCAL
APP_PORT=:8000
LOG_LEVEL=-4
PPROF_ADDR=
DATABASE_URL=postgres://loco_user:loco_password@localhost:5432/loco?sslmode=disable
CACHE_TYPE=valkey
CACHE_ADDR=valkey://127.0.0.1:6379
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_PLATFORM_DOMAIN=onloco.app
MIN_CLI_VERSION=
AGENT_TOKEN=loco-dev-agent-token

GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

WEB_URL=http://localhost:5173
AUTH_ISSUERS='[{"issuer":"http://localhost:9999","preset":"supabase","web":{"adapter":"supabase"},"admin":{"type":"supabase","tokenEnv":"AUTH_SUPABASE_SERVICE_KEY"}}]'
AUTH_SIGNUP_MODE=open
AUTH_SIGNUP_DOMAINS=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM='Loco <noreply@loco.local>'
SMTP_USERNAME=
SMTP_PASSWORD=

GITLAB_URL=https://gitlab.com
GITLAB_REGISTRY_URL=https://registry.gitlab.com
GITLAB_PROJECT_ID=
GITLAB_PAT=
REGISTRY_TAG=

CERT_MANAGER_EMAIL=dev@example.com
CLOUDFLARE_TOKEN=
GRAFANA_ADMIN_PASSWORD=admin
