APP_ENV=LOCAL
APP_PORT=:8000
LOG_LEVEL=-4
PPROF_ADDR=
DATABASE_URL=postgres://loco_user:loco_password@localhost:5432/loco?sslmode=disable
CACHE_TYPE=valkey
CACHE_ADDR=valkey://127.0.0.1:6379
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_PLATFORM_DOMAIN=onloco.app
MIN_CLI_VERSION=
AGENT_TOKEN=loco-dev-agent-token

LOCO_REGISTRY_HOST=loco-registry:5000
LOCO_REGISTRY_PREFIX=
LOCO_SOURCE_BUCKET_ENDPOINT=http://loco-s3.localhost:9000
LOCO_SOURCE_BUCKET=loco-sources
LOCO_SOURCE_BUCKET_REGION=us-east-1
LOCO_SOURCE_BUCKET_ACCESS_KEY_ID=loco-dev
LOCO_SOURCE_BUCKET_SECRET_ACCESS_KEY=loco-dev-secret
LOCO_SOURCE_BUCKET_FORCE_PATH_STYLE=true
LOCO_SOURCE_MAX_BYTES=209715200

GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

WEB_URL=http://localhost:5173
AUTH_ISSUERS='[{"issuer":"http://localhost:9999","audience":"authenticated","preset":"supabase","emailVerification":"admin","web":{"adapter":"supabase"},"admin":{"type":"supabase","tokenEnv":"AUTH_SUPABASE_SERVICE_KEY"}}]'
AUTH_SIGNUP_MODE=open
AUTH_SIGNUP_DOMAINS=

CERT_MANAGER_EMAIL=dev@example.com
CLOUDFLARE_TOKEN=
GRAFANA_ADMIN_PASSWORD=admin
