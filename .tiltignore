# helm dependency tarballs and temp dirs (generated by helm dependency build)
charts/**/charts/*.tgz
charts/**/tmpcharts*

# compiled binaries — air rebuilds these; don't trigger Tilt watches on them
bin/
*/bin/
agent/bin/
observability-proxy/bin/
controller/bin/

# test artifacts
*.out
coverage.html
e2e/bin/
e2e/logs/
e2e/pids/
