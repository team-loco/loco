# with --port and no cluster serving an app domain in the default region, deploy cannot name a
# public hostname and applies nothing.
fakeapi no-app-domain
cd app
! exec loco deploy --port 8080 --yes
stderr '(?i)no cluster of the environment serves an app domain in the region: us-ca-1 in production'
! fakeapi applied 7

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
-- app/Dockerfile --
FROM scratch
