# a file whose services all run public images is applied without a build or an upload.
fakeapi plan plan.json
cd app
exec loco deploy --yes
stdout '^  \+ api$'
stdout '^Applied\. Environment revision is now 8\.$'
stdout '^Started deployment dep-api for api in us-east-1\.$'
stdout '^api has no public URL and takes no internet traffic\.$'
! stdout 'Packed'
! fakeapi called CreateBuild
! fakeapi called Upload
fakeapi applied 7

# naming an image service is an error, since it is never built.
! exec loco deploy api --yes
stderr 'runs a public image and is not built'
! fakeapi applied 8

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  api:
    image: ghcr.io/acme/api:1
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_CREATE", "service": "api", "changes": [{"path": "image", "after": "ghcr.io/acme/api:1"}]}
  ]
}
