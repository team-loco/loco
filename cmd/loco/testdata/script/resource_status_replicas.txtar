# loco resource status lists each region's replicas with their state, restarts, last exit and age.
fakeapi replicas web
env NO_COLOR=1

exec loco resource status web
stdout 'us-east-1 replicas'
stdout 'REPLICA\s+STATE\s+RESTARTS\s+LAST EXIT\s+AGE\s+NODE'
stdout 'web-7d9f-a1\s+Serving\s+0\s+—\s+3h\s+node-1'
stdout 'web-7d9f-b2\s+Failing\s+4\s+OOMKilled \(137\) 5m ago\s+20m\s+node-2'
! stdout 'last reported'

exec loco resource status web -o json
stdout '"replicas":'
stdout '"reason":\s+"OOMKilled"'

[!windows] exec terminal 60 resource status web
[!windows] stdout 'LAST EXIT'
[!windows] stdout 'OOMKilled'

fakeapi replicas web silent
exec loco resource status web
stdout 'web-7d9f-b2'
stdout 'last reported 10m ago'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
