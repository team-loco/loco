# plan and apply print each saved secret of the file's services: a declared one as used,
# an undeclared one with how to bind it.
fakeapi plan plan.json
cd app
exec loco infra plan
stdout '^Secrets of web:$'
stdout '^  SESSION_KEY: in use$'
stdout '^  STRIPE_API_KEY: Saved\. To use this key, add STRIPE_API_KEY to services\.web\.secrets and redeploy\.$'
! stdout 'add SESSION_KEY'

exec loco infra apply --yes
stdout '^Applied\. Environment revision is now 8\.$'
stdout '^  SESSION_KEY: in use$'
stdout '^  STRIPE_API_KEY: Saved\. To use this key, add STRIPE_API_KEY to services\.web\.secrets and redeploy\.$'
! stdout 'add SESSION_KEY'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  web:
    image: ghcr.io/acme/web:1
    secrets: [SESSION_KEY]
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_UPDATE", "service": "web", "changes": [{"path": "secrets", "before": "SESSION_KEY, STRIPE_API_KEY", "after": "SESSION_KEY"}]}
  ],
  "savedSecrets": [
    {"service": "web", "name": "SESSION_KEY", "declared": true},
    {"service": "web", "name": "STRIPE_API_KEY"}
  ]
}
