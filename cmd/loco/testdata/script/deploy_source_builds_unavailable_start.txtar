# A StartBuild refused because builds are unavailable gets the same advice as CreateBuild.
fakeapi builds-unavailable StartBuild
cd app
! exec loco deploy app
stderr '(?i)this Loco install cannot build from source: no cluster in this install accepts builds'
stderr 'loco deploy <name> --image <image>'
fakeapi called StartBuild

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- app/loco.toml --
[Metadata]
ConfigVersion = "0.1"
Name = "app"
Type = "SERVICE"
Region = "us-east-1"

[Build]
DockerfilePath = "Dockerfile"
Type = "docker"

[Routing]
Port = 8080
PathPrefix = "/"
IdleTimeout = 60

[RegionConfig]
[RegionConfig.us-east-1]
CPU = "100m"
Memory = "256Mi"
ReplicasMin = 1
ReplicasMax = 1
[RegionConfig.eu-west-1]
CPU = "100m"
Memory = "256Mi"
ReplicasMin = 1
ReplicasMax = 2

[Health]
Path = "/healthz"
Interval = 30
Timeout = 5
StartupGracePeriod = 0
FailThreshold = 3
-- app/Dockerfile --
FROM scratch
COPY main.go /
-- app/main.go --
package main
