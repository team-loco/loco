# an expired token without a refresh token asks for a new login instead of calling the API.
! exec loco whoami
stderr 'Token is expired'
! fakeapi called RefreshToken
! fakeapi called WhoAmI

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2000-01-01T00:00:00Z","Token":"expired-token","RefreshToken":""}
