# two source services share one archive packed with the repository's .dockerignore. Every
# selected Dockerfile is kept even when .dockerignore excludes it, whatever the order of the
# services on the command line.
fakeapi resource worker
fakeapi plan plan.json
cd repo
exec loco deploy worker api --yes
stdout '^Packed 6 files from \. \('
stdout '^Building worker from Dockerfile in worker$'
stdout '^Building api from build/Dockerfile in api$'
stdout '^Created api before building\.$'
fakeapi uploaded api/build/Dockerfile
fakeapi uploaded worker/Dockerfile
fakeapi uploaded .dockerignore
! fakeapi uploaded api/build/Dockerfile.dockerignore
! fakeapi uploaded docs/Dockerfile
fakeapi provisioned 7 api
fakeapi provisioned 8
fakeapi built api build/Dockerfile api
fakeapi built worker Dockerfile worker

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- repo/loco.yaml --
version: 1
partial: web
services:
  api:
    dockerfile: build/Dockerfile
    context: api
    port: 8080
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
  worker:
    context: worker
    port: 8080
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- repo/.dockerignore --
**/Dockerfile
**/*.dockerignore
docs
-- repo/api/build/Dockerfile --
FROM scratch
COPY main.go /
-- repo/api/build/Dockerfile.dockerignore --
main.go
-- repo/api/main.go --
package main
-- repo/worker/Dockerfile --
FROM scratch
COPY worker.go /
-- repo/worker/worker.go --
package main
-- repo/docs/Dockerfile --
FROM scratch
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_CREATE", "service": "api", "needsDeploy": true},
    {"kind": "PLAN_OPERATION_KIND_UPDATE", "service": "worker", "needsDeploy": true}
  ]
}
