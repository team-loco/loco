fakeapi plan plan.json
cd app
! exec loco deploy api --image ghcr.io/acme/api:release --yes
stderr 'confirm-destructive'
! fakeapi called Apply
fakeapi plan ../errors.json
! exec loco deploy api --image 'invalid image reference' --yes
stderr 'image could not be resolved'
! fakeapi called Apply
! fakeapi called CreateBuild
! fakeapi called Upload

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
currentScope: default
scopes:
  default:
    organization:
      name: acme
      id: "1"
    workspace:
      name: production
      id: "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  api:
    image: ghcr.io/acme/api:old
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- plan.json --
{"revision":"7","operations":[{"kind":"PLAN_OPERATION_KIND_UPDATE","service":"api","destructive":true,"changes":[{"path":"image","after":"ghcr.io/acme/api:release"}]}]}
-- errors.json --
{"revision":"7","errors":[{"service":"api","path":"image","message":"image could not be resolved"}]}
