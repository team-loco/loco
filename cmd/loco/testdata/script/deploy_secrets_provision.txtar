# a new service whose only plan errors are its missing secrets is created without a build or a
# deployment; deploy prints the command that sets them and exits 1.
fakeapi plan other-errors.json
cd app
! exec loco deploy --yes
stderr '(?i)loco.yaml cannot be applied:'
stderr '  web regions.us-west-9: region us-west-9 is not available'
! fakeapi called Apply

fakeapi plan ../missing-secrets.json
! exec loco deploy
stderr '(?i)stdout is not a terminal; pass --yes'
! fakeapi called Apply

! exec loco deploy --yes
stdout '^Created web\. Set its secrets with: loco env set --service web --env production SESSION_KEY=\.\.\. STRIPE_API_KEY=\.\.\.$'
stderr '(?i)set the secrets of the new services, then run the command again'
! stdout 'Packed'
! fakeapi called CreateBuild
fakeapi provisioned 7 web

# once web exists, its missing secrets are plan errors again and nothing is created.
! exec loco deploy --yes
stderr '(?i)apply refused: the plan has errors:'
stderr '  web secrets: secret is not set for the service in the environment: STRIPE_API_KEY'
! fakeapi called CreateBuild

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
currentScope: default
scopes:
  default:
    organization:
      name: acme
      id: "1"
    workspace:
      name: production
      id: "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  web:
    port: 8080
    secrets: [STRIPE_API_KEY, SESSION_KEY]
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- app/Dockerfile --
FROM scratch
-- other-errors.json --
{
  "revision": "7",
  "errors": [
    {"service": "web", "path": "secrets", "message": "secret is not set for the service in the environment: SESSION_KEY"},
    {"service": "web", "path": "regions.us-west-9", "message": "region us-west-9 is not available"}
  ]
}
-- missing-secrets.json --
{
  "revision": "7",
  "errors": [
    {"service": "web", "path": "secrets", "message": "secret is not set for the service in the environment: SESSION_KEY"},
    {"service": "web", "path": "secrets", "message": "secret is not set for the service in the environment: STRIPE_API_KEY"}
  ]
}
