# loco secret push sets every KEY=VALUE line of a .env file on one environment in one SetSecrets
# call, expanding nothing.
exec loco secret push --env production app.env
stdout '^Set 3 secrets \(revision 1\)$'
stdout '^  API_KEY v1$'
stdout '^  DATABASE_URL v1$'
stdout '^  GREETING v1$'
! stdout 'postgres://'
! stdout 'next deploy or restart'
fakeapi called SetSecrets 'Bearer test-token'
fakeapi secret production DATABASE_URL 'postgres://user:p$ss@db:5432/app'
fakeapi secret production API_KEY 'abc 123'
fakeapi secret production GREETING 'hello ${NAME}'

# Without a file the lines come from stdin, and a second push bumps the version. The services
# reading a changed value are listed with the command that restarts each.
fakeapi resource web
fakeapi resource worker
fakeapi secret-usage production API_KEY worker web
stdin stdin.env
exec loco secret push --env production
stdout '^Set 1 secrets \(revision 2\)$'
stdout '^  API_KEY v2$'
stdout '^These services read a changed value and get it on their next deploy or restart:$'
stdout '^  loco resource restart web --env production$'
stdout '^  loco resource restart worker --env production$'
! stdout 'from-stdin'
fakeapi secret production API_KEY 'from-stdin'

# A broken line is reported by number; its text never reaches the output.
! exec loco secret push --env production broken.env
stderr '(?i)broken.env: line 3: unterminated quote'
! stderr 'hunter2'
! stdout .

# A file with no assignments is refused before any call.
! exec loco secret push --env production empty.env
stderr 'no KEY=VALUE lines'

# A missing file is reported by name.
! exec loco secret push --env production nope.env
stderr 'open nope.env'

# An install with no secrets key provider refuses the write.
fakeapi fail SetSecrets failed_precondition
! exec loco secret push --env production app.env
stderr '(?i)set secrets: fakeapi: SetSecrets configured to fail'
! stdout .

-- app.env --
# database
export DATABASE_URL='postgres://user:p$ss@db:5432/app'

API_KEY="abc 123" # inline note
GREETING=hello ${NAME}
-- stdin.env --
API_KEY=from-stdin
-- broken.env --
A=1
B=2
C="hunter2
-- empty.env --
# only a comment

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
