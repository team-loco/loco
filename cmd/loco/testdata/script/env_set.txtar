# loco env set takes KEY=VALUE arguments for one service; a bare KEY reads its value from stdin.
fakeapi resource web
fakeapi resource worker
exec loco env set --service web --env production API_KEY=abc123 LOG_LEVEL=debug
stdout '^Set 2 secrets \(revision 1\)$'
stdout '^  API_KEY v1$'
stdout '^  LOG_LEVEL v1$'
! stdout 'abc123'
fakeapi called SetSecrets 'Bearer test-token'
fakeapi secret web API_KEY 'abc123'
fakeapi secret web LOG_LEVEL 'debug'

stdin value.txt
exec loco env set --service web --env production DATABASE_URL
stdout '^Set 1 secrets \(revision 2\)$'
fakeapi secret web DATABASE_URL 'postgres://user:p$ss@db:5432/app'

# The value keeps its "=" and is empty when nothing follows the first one.
exec loco env set --service web --env production TOKEN=a=b EMPTY=
fakeapi secret web TOKEN 'a=b'
fakeapi secret web EMPTY ''

# LOCO_ENV selects the environment like --env does.
env LOCO_ENV=production
exec loco env set --service web LOG_LEVEL=info
fakeapi secret web LOG_LEVEL 'info'
env LOCO_ENV=

# An unknown environment is refused before any write.
! exec loco env set --service web --env staging LOG_LEVEL=warn
stderr '(?i)environment "staging" not found; the workspace has production'
fakeapi secret web LOG_LEVEL 'info'

# Two services hold the same name apart.
exec loco env set --service worker --env production API_KEY=worker-key
stdout '^  API_KEY v1$'
fakeapi secret worker API_KEY 'worker-key'
fakeapi secret web API_KEY 'abc123'

# --service is required, and an unknown service fails before any secret call.
! exec loco env set --env production API_KEY=nothing
stderr '(?i)required flag\(s\) "service" not set'
! exec loco env set --service nope --env production API_KEY=nothing
stderr '(?i)service "nope" not found'
fakeapi secret web API_KEY 'abc123'

# Only one name can take its value from stdin.
! exec loco env set --service web --env production A B
stderr '(?i)only one name can take its value from stdin'

# An argument with no name is refused by position; its text is not echoed.
! exec loco env set --service web --env production =hunter2
stderr '(?i)argument 1: empty name'
! stderr 'hunter2'

# An install with no secrets key provider refuses the write.
fakeapi fail SetSecrets failed_precondition
! exec loco env set --service web --env production API_KEY=later
stderr '(?i)set secrets: fakeapi: SetSecrets configured to fail'
fakeapi secret web API_KEY 'abc123'

-- value.txt --
postgres://user:p$ss@db:5432/app
-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
currentScope: default
scopes:
  default:
    organization:
      name: acme
      id: "1"
    workspace:
      name: production
      id: "2"
