# loco secret set takes KEY=VALUE arguments for one environment; a bare KEY reads its value from
# stdin.
exec loco secret set --env production API_KEY=abc123 LOG_LEVEL=debug
stdout '^Set 2 secrets \(revision 1\)$'
stdout '^  API_KEY v1$'
stdout '^  LOG_LEVEL v1$'
! stdout 'abc123'
fakeapi called SetSecrets 'Bearer test-token'
fakeapi secret production API_KEY 'abc123'
fakeapi secret production LOG_LEVEL 'debug'

stdin value.txt
exec loco secret set --env production DATABASE_URL
stdout '^Set 1 secrets \(revision 2\)$'
! stdout 'postgres://'
fakeapi secret production DATABASE_URL 'postgres://user:p$ss@db:5432/app'

# The value keeps its "=" and is empty when nothing follows the first one.
exec loco secret set --env production TOKEN=a=b EMPTY=
fakeapi secret production TOKEN 'a=b'
fakeapi secret production EMPTY ''

# A service whose latest deployment reads a changed value is named with its restart command.
fakeapi resource web
fakeapi secret-usage production API_KEY web
exec loco secret set --env production API_KEY=def456
stdout '^These services read a changed value and get it on their next deploy or restart:$'
stdout '^  loco resource restart web --env production$'
! stdout 'def456'

# LOCO_ENV selects the environment like --env does.
env LOCO_ENV=production
exec loco secret set LOG_LEVEL=info
fakeapi secret production LOG_LEVEL 'info'
env LOCO_ENV=

# An unknown environment is refused before any write.
! exec loco secret set --env staging LOG_LEVEL=warn
stderr '(?i)environment "staging" not found; the workspace has production'
fakeapi secret production LOG_LEVEL 'info'

# Two environments hold the same name apart.
fakeapi environment staging
exec loco secret set --env staging API_KEY=staging-key
stdout '^  API_KEY v1$'
! stdout 'next deploy or restart'
fakeapi secret staging API_KEY 'staging-key'
fakeapi secret production API_KEY 'def456'

# Only one name can take its value from stdin.
! exec loco secret set --env production A B
stderr '(?i)only one name can take its value from stdin'

# An argument with no name is refused by position; its text is not echoed.
! exec loco secret set --env production =hunter2
stderr '(?i)argument 1: empty name'
! stderr 'hunter2'

# An install with no secrets key provider refuses the write.
fakeapi fail SetSecrets failed_precondition
! exec loco secret set --env production API_KEY=later
stderr '(?i)set secrets: fakeapi: SetSecrets configured to fail'
fakeapi secret production API_KEY 'def456'

-- value.txt --
postgres://user:p$ss@db:5432/app
-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
