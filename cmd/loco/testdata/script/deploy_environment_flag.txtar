# --env must name one of the workspace's environments, and selects the override the file
# resolves: in staging the service is disabled, so there is nothing to build.
fakeapi plan plan.json
cd app
! exec loco deploy --yes --env staging
stderr '(?i)environment "staging" not found; the workspace has production'
! fakeapi called Plan

exec loco deploy --yes --env production
stdout '^Applied\. Environment revision is now 8\.$'
fakeapi planned loco.yaml

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  api:
    image: ghcr.io/acme/api:1
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- plan.json --
{"revision": "7"}
