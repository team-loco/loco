# a misconfigured credential store only fails the commands that need credentials.
env LOCO_CREDENTIAL_STORE=bogus
exec loco --help
stdout 'logout'
exec loco validate --help
stdout 'loco.yaml'

! exec loco logout
stderr 'LOCO_CREDENTIAL_STORE "bogus"'
! exec loco whoami
stderr 'LOCO_CREDENTIAL_STORE "bogus"'
