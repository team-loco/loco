fakeapi plan plan.json
fakeapi resource worker
cd app
exec loco deploy api --image ghcr.io/acme/api:release --yes
stdout '^Applied\. Environment revision is now 8\.$'
! stdout 'Packed'
! fakeapi called CreateBuild
! fakeapi called Upload
fakeapi applied 7
fakeapi image-override api ghcr.io/acme/api:release
cmp loco.yaml original.yaml

! exec loco deploy --image ghcr.io/acme/api:release --yes
stderr 'selecting exactly one service'
! exec loco deploy api worker --image ghcr.io/acme/api:release --yes
stderr 'selecting exactly one service'
! exec loco deploy disabled --image ghcr.io/acme/api:release --yes
stderr 'file does not run the service'
! exec loco deploy missing --image ghcr.io/acme/api:release --yes
stderr 'file does not run the service'
! exec loco deploy api --image= --yes
stderr '(?i)image reference must not be empty'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
currentScope: default
scopes:
  default:
    organization:
      name: acme
      id: "1"
    workspace:
      name: production
      id: "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  api:
    dockerfile: missing/Dockerfile
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
  disabled:
    dockerfile: missing/Dockerfile
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
    environments:
      production:
        enabled: false
  worker:
    dockerfile: other/missing/Dockerfile
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- app/original.yaml --
version: 1
partial: web
services:
  api:
    dockerfile: missing/Dockerfile
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
  disabled:
    dockerfile: missing/Dockerfile
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
    environments:
      production:
        enabled: false
  worker:
    dockerfile: other/missing/Dockerfile
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
