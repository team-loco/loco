{"revision":"7","operations":[{"kind":"PLAN_OPERATION_KIND_UPDATE","service":"api","changes":[{"path":"image","after":"ghcr.io/acme/api:release"}]}],"images":{"ghcr.io/acme/api:release":"ghcr.io/acme/api@sha256:abc"}}
