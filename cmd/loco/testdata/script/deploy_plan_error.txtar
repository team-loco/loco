# plan errors stop the deploy before anything is packed, built or applied.
fakeapi resource web
fakeapi plan errors.json
cd app
! exec loco deploy --yes
stderr '(?i)loco.yaml cannot be applied:'
stderr '  web regions.us-west-9: region us-west-9 is not available'
! stdout 'Packed'
! fakeapi called CreateBuild
! fakeapi called Apply

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  web:
    port: 8080
    domains: [web.onloco.test]
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- app/Dockerfile --
FROM scratch
COPY main.go /
-- app/main.go --
package main
-- app/.dockerignore --
node_modules
!.env
!.git
-- app/.env --
SECRET=root
-- app/.env.local --
SECRET=local
-- app/web/.env --
SECRET=nested
-- app/web/index.js --
console.log("app")
-- app/node_modules/left-pad/index.js --
module.exports = 1
-- app/.git/HEAD --
ref: refs/heads/main
-- errors.json --
{
  "revision": "7",
  "errors": [
    {"service": "web", "path": "regions.us-west-9", "message": "region us-west-9 is not available"}
  ]
}
