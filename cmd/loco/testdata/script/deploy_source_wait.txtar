# loco deploy --wait shows the build stages and the rollout in one stream.
fakeapi resource web
fakeapi plan plan.json
cd app
exec loco deploy --yes --wait
stdout '^Building web from Dockerfile in \.$'
stdout '^Fetching source$'
stdout '^Building image$'
stdout '^Pushing image$'
stdout '^Build succeeded$'
stdout '^dep-web · Serving traffic$'
! stdout 'Build .* running'
stdout '^Started deployment dep-web for web in us-east-1\.$'
! stdout '\x1b\['
! fakeapi called GetBuild
fakeapi built web Dockerfile .

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
currentScope: default
scopes:
  default:
    organization:
      name: acme
      id: "1"
    workspace:
      name: production
      id: "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  web:
    port: 8080
    domains: [web.onloco.test]
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- app/Dockerfile --
FROM scratch
COPY main.go /
-- app/main.go --
package main
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_UPDATE", "service": "web", "needsDeploy": true}
  ]
}
