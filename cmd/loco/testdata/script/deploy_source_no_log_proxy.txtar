# Without an observability proxy for the build's cluster, loco deploy says the build logs
# are unavailable and keeps following the build to the deployment.
fakeapi resource web
fakeapi plan plan.json
fakeapi no-proxy
cd app
exec loco deploy --yes
stdout 'Build logs are unavailable'
stdout 'Build 0199b6c4-5d1e-7f00-8000-000000000001 succeeded'
stdout '^Started deployment dep-web for web in us-east-1\.$'
! fakeapi called TailLogs 'Bearer test-token'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  web:
    port: 8080
    domains: [web.onloco.test]
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- app/Dockerfile --
FROM scratch
COPY main.go /
-- app/main.go --
package main
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_UPDATE", "service": "web", "needsDeploy": true}
  ]
}
