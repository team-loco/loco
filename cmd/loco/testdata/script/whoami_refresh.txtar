# an expiring token is refreshed against the host the command was given, not the default host.
env FAKE_HOST=$LOCO_HOST
env LOCO_HOST=
exec loco whoami --host $FAKE_HOST
stdout 'Hi, Test User!'
fakeapi called RefreshToken
fakeapi called WhoAmI 'Bearer refreshed-token'
grep refreshed-token $HOME/.loco/credentials.json

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2000-01-01T00:00:00Z","Token":"expired-token","RefreshToken":"test-refresh-token"}
