# loco resource logs reads the service's logs through the regional log proxy.
fakeapi seed app

exec loco resource logs app
stdout '^2026-10-07T06:00:00Z  listening on :8080$'
stdout '^2026-10-07T06:00:01Z  GET /healthz 200$'
fakeapi called GetObservabilityAccess 'Bearer test-token'
fakeapi called QueryLogs 'Bearer test-token'

exec loco resource logs app --output json
stdout '"body":"listening on :8080"'

! exec loco resource logs app --since 48h
stderr '(?i)the log proxy reads at most 24h back'

fakeapi no-proxy
! exec loco resource logs app
stderr '(?i)no logs to show for app'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
