# --wait fails the command when a deployment is canceled.
fakeapi plan plan.json
fakeapi deployment dep-web canceled
! exec loco infra apply --yes --wait
stderr 'deployment dep-web for web in us-east-1 was canceled'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
currentScope: default
scopes:
  default:
    organization:
      name: acme
      id: "1"
    workspace:
      name: production
      id: "2"
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_CREATE", "service": "api", "changes": [{"path": "image", "after": "ghcr.io/acme/api:1"}]},
    {"kind": "PLAN_OPERATION_KIND_UPDATE", "service": "web", "changes": [{"path": "env.TIER", "after": "prod"}]}
  ]
}
-- loco.yaml --
version: 1
partial: web
services:
  api:
    image: ghcr.io/acme/api:1
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
