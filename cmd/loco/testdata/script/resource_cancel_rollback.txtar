# loco resource cancel --rollback rolls back the regions the deployment already runs, and
# --json prints the queued rollback deployments.
fakeapi resource web
fakeapi deployment dep-old running
fakeapi deployment dep-new deploying
fakeapi finished dep-new us-east-1=dep-old eu-west-1=none

exec loco resource cancel web
stdout 'Deployment dep-new already runs in:'
stdout '  us-east-1: previous version dep-old \(commit aaaaaaa\), deployed 2026-11-18 14:02 UTC'
stdout '  eu-west-1: first deployment there, nothing to roll back to'
stdout 'Pass --rollback to roll them back.'
stdout 'Canceled deployment dep-new of web in production'
! stdout 'Queued rollback'
fakeapi canceled dep-new no-rollback

exec loco resource cancel web --rollback
stdout 'Queued rollback deployment rollback-dep-old'
fakeapi canceled dep-new rollback

exec loco resource cancel web --rollback --json
cmp stdout want.json

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
-- want.json --
{
  "deploymentId": "dep-new",
  "rollbackDeploymentIds": [
    "rollback-dep-old"
  ]
}
