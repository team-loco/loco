# when no cluster in the install accepts builds, CreateBuild refuses before an upload URL
# exists, and loco deploy points at the image key of loco.yaml.
fakeapi resource web
fakeapi builds-unavailable CreateBuild
fakeapi plan plan.json
cd app
! exec loco deploy --yes
stderr '(?i)cannot build from source: no cluster in this install accepts builds'
stderr 'Set image on the service in'
! fakeapi called Upload
! fakeapi called StartBuild
! fakeapi called Apply

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  web:
    port: 8080
    domains: [web.onloco.test]
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- app/Dockerfile --
FROM scratch
COPY main.go /
-- app/main.go --
package main
-- app/.dockerignore --
node_modules
!.env
!.git
-- app/.env --
SECRET=root
-- app/.env.local --
SECRET=local
-- app/web/.env --
SECRET=nested
-- app/web/index.js --
console.log("app")
-- app/node_modules/left-pad/index.js --
module.exports = 1
-- app/.git/HEAD --
ref: refs/heads/main
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_UPDATE", "service": "web", "needsDeploy": true}
  ]
}
