# --wait prints each region's state as it changes and names the regions that failed.
fakeapi plan plan.json
fakeapi deployment dep-api failed us-ca-1=running us-va-1=failed
cd app
! exec loco deploy --yes --wait
stdout '^us-ca-1 · deploying$'
stdout '^us-ca-1 · running$'
stdout '^us-va-1 · failed$'
stderr 'dep-api for api in us-ca-1 failed: us-va-1: replicas crash on'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
-- app/loco.yaml --
version: 1
partial: web
services:
  api:
    image: ghcr.io/acme/api:1
    regions:
      us-ca-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- plan.json --
{
  "revision": "7",
  "operations": [
    {"kind": "PLAN_OPERATION_KIND_CREATE", "service": "api", "changes": [{"path": "image", "after": "ghcr.io/acme/api:1"}]}
  ]
}
