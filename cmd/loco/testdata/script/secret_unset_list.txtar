# loco secret list shows an environment's names, versions, the services reading each and who set
# them; loco secret unset removes names. Neither prints a value.
exec loco secret list --env production
stdout '^production has no secrets\.$'
fakeapi called ListSecrets 'Bearer test-token'

exec loco secret set --env production API_KEY=abc123 LOG_LEVEL=debug
exec loco secret set --env production API_KEY=def456
fakeapi resource web
fakeapi resource worker
fakeapi secret-usage production API_KEY web worker

exec loco secret list --env production
stdout '^NAME +VERSION +USED BY +UPDATED BY +UPDATED AT$'
stdout '^API_KEY +2 +web,worker +user:00000000-0000-7000-8000-0000000000a9 +2026-10-07T06:00:00Z$'
stdout '^LOG_LEVEL +1 +- +user:00000000-0000-7000-8000-0000000000a9 +2026-10-07T06:00:00Z$'
! stdout 'abc123'
! stdout 'def456'
! stdout 'debug'

# A secret a service still reads is not removed; the error names the services.
! exec loco secret unset --env production API_KEY
stderr '(?i)unset secrets: secret is read by the latest deployment of a resource: web, worker'
fakeapi secret production API_KEY 'def456'

# Once nothing reads it, it can be removed.
fakeapi secret-usage production API_KEY
exec loco secret unset --env production API_KEY
stdout '^Removed API_KEY \(revision 3\)$'
fakeapi called DeleteSecrets 'Bearer test-token'
! fakeapi secret production API_KEY ''
fakeapi secret production LOG_LEVEL 'debug'

exec loco secret list --env production
! stdout 'API_KEY'
stdout '^LOG_LEVEL +1 '

# Another environment holds its own names: staging's LOG_LEVEL is apart from production's.
fakeapi environment staging
exec loco secret set --env staging LOG_LEVEL=warn
exec loco secret list --env staging
stdout '^LOG_LEVEL +1 '
exec loco secret unset --env staging LOG_LEVEL
fakeapi secret production LOG_LEVEL 'debug'
exec loco secret list --env staging
stdout '^staging has no secrets\.$'

# An unknown environment fails before any secret call.
! exec loco secret unset --env nope LOG_LEVEL
stderr '(?i)environment "nope" not found'
! exec loco secret list --env nope
stderr '(?i)environment "nope" not found'
fakeapi secret production LOG_LEVEL 'debug'

# A name that does not exist is refused by the API with the name in the message.
! exec loco secret unset --env production LOG_LEVEL MISSING
stderr '(?i)unset secrets: secret not found: MISSING'
fakeapi secret production LOG_LEVEL 'debug'

# unset needs at least one name.
! exec loco secret unset --env production
stderr '(?i)requires at least 1 arg'

# LOCO_ENV selects the environment like --env does.
env LOCO_ENV=production
exec loco secret unset LOG_LEVEL
stdout '^Removed LOG_LEVEL \(revision 6\)$'
env LOCO_ENV=

# An install with no secrets key provider refuses the delete.
fakeapi fail DeleteSecrets failed_precondition
! exec loco secret unset --env production LOG_LEVEL
stderr '(?i)unset secrets: fakeapi: DeleteSecrets configured to fail'

fakeapi fail ListSecrets failed_precondition
! exec loco secret list --env production
stderr '(?i)list secrets: fakeapi: ListSecrets configured to fail'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.yaml --
organization:
  name: acme
  id: "1"
workspace:
  name: production
  id: "2"
