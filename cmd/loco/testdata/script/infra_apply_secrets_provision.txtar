# loco infra apply creates a new service whose only plan errors are its missing secrets, prints
# the command that sets them and exits 1; other services are left for the next apply.
fakeapi plan missing-secrets.json
! exec loco infra apply --yes
stdout '^Created worker\. Set its secrets with: loco env set --service worker --env production DATABASE_URL=\.\.\.$'
stderr '(?i)set the secrets of the new services, then run the command again'
fakeapi provisioned 7 worker

# a service that already exists is not created again; its missing secrets refuse the apply.
! exec loco infra apply --yes
stderr '(?i)apply refused: the plan has errors:'
stderr '  worker secrets: secret is not set for the service in the environment: DATABASE_URL'

-- home/.loco/credentials.json --
{"Host":"${LOCO_HOST}","ExpiresAt":"2099-01-01T00:00:00Z","Token":"test-token","RefreshToken":""}
-- home/.loco/config.toml --
currentScope = "default"

[scopes.default.organization]
name = "acme"
id = "1"

[scopes.default.workspace]
name = "production"
id = "2"
-- loco.yaml --
version: 1
partial: web
services:
  api:
    image: ghcr.io/acme/api:1
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
  worker:
    image: ghcr.io/acme/worker:1
    secrets: [DATABASE_URL]
    regions:
      us-east-1: { cpu: 100m, memory: 256Mi, replicas: { min: 1, max: 1 } }
-- missing-secrets.json --
{
  "revision": "7",
  "errors": [
    {"service": "worker", "path": "secrets", "message": "secret is not set for the service in the environment: DATABASE_URL"}
  ]
}
