{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "release",
    "controlPlane",
    "workers"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kubernetes",
        "apiURL",
        "webURL",
        "database",
        "auth",
        "sourceBucket",
        "registry",
        "openbao",
        "observability",
        "certificates"
      ],
      "properties": {
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context",
            "namespace",
            "clusterUID"
          ],
          "properties": {
            "context": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "clusterUID": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "apiURL": {
          "type": "string",
          "minLength": 1
        },
        "webURL": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretRef"
          ],
          "properties": {
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "clientId",
            "signupMode",
            "bootstrapRedirectURI"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "signupMode": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "open",
                "closed"
              ]
            },
            "bootstrapRedirectURI": {
              "type": "string",
              "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/callback$"
            }
          }
        },
        "sourceBucket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "region",
            "bucket",
            "credentialsSecretRef"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "credentialsSecretRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "credentialsSecretRef"
          ],
          "properties": {
            "credentialsSecretRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "openbao": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "managed",
            "seal",
            "snapshots"
          ],
          "properties": {
            "managed": {
              "type": "boolean",
              "const": true
            },
            "seal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "static"
                  ]
                }
              }
            },
            "snapshots": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpoint",
                "region",
                "bucket",
                "credentialsSecretRef"
              ],
              "properties": {
                "endpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "region": {
                  "type": "string",
                  "minLength": 1
                },
                "bucket": {
                  "type": "string",
                  "minLength": 1
                },
                "credentialsSecretRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "ingestURL"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": true
            },
            "ingestURL": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "certificates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuerRef"
          ],
          "properties": {
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kubernetes",
          "region",
          "tier",
          "applicationsAllowed",
          "appsDomain",
          "builds",
          "certificates",
          "metricsServer"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kubernetes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "context",
              "namespace",
              "clusterUID"
            ],
            "properties": {
              "context": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "clusterUID": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "staging",
              "production"
            ]
          },
          "applicationsAllowed": {
            "type": "boolean"
          },
          "appsDomain": {
            "type": "string",
            "minLength": 1
          },
          "builds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allowed",
              "privateEgress"
            ],
            "properties": {
              "allowed": {
                "type": "boolean"
              },
              "privateEgress": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cidr",
                    "port"
                  ],
                  "properties": {
                    "cidr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  }
                }
              }
            }
          },
          "certificates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuerRef"
            ],
            "properties": {
              "issuerRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "Issuer",
                      "ClusterIssuer"
                    ]
                  }
                }
              }
            }
          },
          "metricsServer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "kubeletInsecureTLS": {
                "type": "boolean"
              }
            },
            "required": [
              "enabled",
              "kubeletInsecureTLS"
            ]
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "const": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loco.build/schemas/installation.v1.json",
  "title": "Loco installation"
}
