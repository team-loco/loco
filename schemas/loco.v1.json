{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loco.build/schemas/loco.v1.json",
  "$defs": {
    "Autoscaling": {
      "properties": {
        "cpuTarget": {
          "type": "integer",
          "maximum": 100,
          "minimum": 1,
          "description": "Average CPU utilization percent to hold."
        },
        "memoryTarget": {
          "type": "integer",
          "maximum": 100,
          "minimum": 1,
          "description": "Average memory utilization percent to hold."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Deploy": {
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Times a cluster tries to apply a deployment before it is marked failed."
        },
        "retryDelay": {
          "type": "integer",
          "minimum": 60,
          "description": "Seconds between attempts."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Health": {
      "properties": {
        "path": {
          "type": "string",
          "description": "HTTP path the check requests."
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds between checks."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds before a check counts as failed."
        },
        "failThreshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Consecutive failures before the container restarts."
        },
        "startupGracePeriod": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds after start before checks begin."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Override": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "false excludes the service from this environment."
        },
        "dockerfile": {
          "type": [
            "string",
            "null"
          ],
          "description": "Dockerfile path relative to context."
        },
        "context": {
          "type": [
            "string",
            "null"
          ],
          "description": "Build context relative to the file."
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "description": "Public image reference."
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 65535,
          "minimum": 1,
          "description": "Container port."
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverrideHealth"
            },
            {
              "type": "null"
            }
          ],
          "description": "HTTP health check fields to merge. Null removes the inherited check."
        },
        "routing": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverrideRouting"
            },
            {
              "type": "null"
            }
          ],
          "description": "Routing fields to merge."
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ],
          "description": "Replaces the service's domains."
        },
        "env": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": [
            "object",
            "null"
          ],
          "description": "Environment variables to merge. null removes one."
        },
        "secrets": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ],
          "description": "Replaces the service's secret names."
        },
        "regions": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/OverrideRegion"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": [
            "object",
            "null"
          ],
          "description": "Region fields to merge keyed by region name."
        },
        "runAsUser": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Positive numeric UID for the application process. Omitted uses the image user.",
          "maximum": 2147483647
        },
        "runAsGroup": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Positive numeric primary GID for the application process. Omitted uses the image group.",
          "maximum": 2147483647
        },
        "observability": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverrideObservability"
            },
            {
              "type": "null"
            }
          ],
          "description": "Automatic OpenTelemetry SDK environment configuration, enabled by default."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OverrideAutoscaling": {
      "properties": {
        "cpuTarget": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 100,
          "minimum": 1,
          "description": "Average CPU utilization percent to hold."
        },
        "memoryTarget": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 100,
          "minimum": 1,
          "description": "Average memory utilization percent to hold."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OverrideHealth": {
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "HTTP path the check requests."
        },
        "interval": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Seconds between checks."
        },
        "timeout": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Seconds before a check counts as failed."
        },
        "failThreshold": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Consecutive failures before the container restarts."
        },
        "startupGracePeriod": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Seconds after start before checks begin."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OverrideRegion": {
      "properties": {
        "cpu": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^((1\\d{2}|[2-9]\\d{2}|1\\d{3}|2000)m|0?\\.[1-9]\\d*|1(\\.\\d+)?|2(\\.0+)?)$",
          "description": "CPU per replica, from 100m to 2000m, as whole millicores such as 250m or cores such as 0.5."
        },
        "memory": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^((3[2-9]|[4-9]\\d|[1-9]\\d{2}|[1-3]\\d{3}|40[0-8]\\d|409[0-6])Mi|([1-3](\\.\\d+)?|4(\\.0+)?)Gi)$",
          "description": "Memory per replica, from 32Mi to 4Gi, as whole mebibytes such as 512Mi or gibibytes such as 1.5Gi."
        },
        "replicas": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverrideReplicas"
            },
            {
              "type": "null"
            }
          ],
          "description": "Replica bounds."
        },
        "autoscaling": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverrideAutoscaling"
            },
            {
              "type": "null"
            }
          ],
          "description": "Scales replicas between min and max on one target."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OverrideReplicas": {
      "properties": {
        "min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10,
          "description": "Fewest replicas."
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10,
          "description": "Most replicas."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OverrideRouting": {
      "properties": {
        "pathPrefix": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path prefix the domain routes to the service."
        },
        "idleTimeout": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Seconds an idle connection stays open."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Region": {
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^((1\\d{2}|[2-9]\\d{2}|1\\d{3}|2000)m|0?\\.[1-9]\\d*|1(\\.\\d+)?|2(\\.0+)?)$",
          "description": "CPU per replica, from 100m to 2000m, as whole millicores such as 250m or cores such as 0.5."
        },
        "memory": {
          "type": "string",
          "pattern": "^((3[2-9]|[4-9]\\d|[1-9]\\d{2}|[1-3]\\d{3}|40[0-8]\\d|409[0-6])Mi|([1-3](\\.\\d+)?|4(\\.0+)?)Gi)$",
          "description": "Memory per replica, from 32Mi to 4Gi, as whole mebibytes such as 512Mi or gibibytes such as 1.5Gi."
        },
        "replicas": {
          "$ref": "#/$defs/Replicas",
          "description": "Replica bounds."
        },
        "autoscaling": {
          "$ref": "#/$defs/Autoscaling",
          "description": "Scales replicas between min and max on one target."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Replicas": {
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Fewest replicas."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Most replicas."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Routing": {
      "properties": {
        "pathPrefix": {
          "type": "string",
          "description": "Path prefix the domain routes to the service."
        },
        "idleTimeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds an idle connection stays open."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Service": {
      "properties": {
        "dockerfile": {
          "type": "string",
          "description": "Dockerfile path relative to context. A service without image is built from the uploaded source.",
          "default": "Dockerfile"
        },
        "context": {
          "type": "string",
          "description": "Build context relative to the file. Not with image.",
          "default": "."
        },
        "image": {
          "type": "string",
          "description": "Public image reference. A tag is resolved to a digest at plan time. Not with dockerfile or context."
        },
        "port": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 1,
          "description": "Container port. Without it the service is a worker: it gets no Kubernetes Service, domains, routing or readiness probe."
        },
        "health": {
          "$ref": "#/$defs/Health",
          "description": "Optional HTTP liveness and readiness checks on port. Without it a replica is ready once it accepts TCP connections on port; an empty object uses API defaults. Needs port."
        },
        "routing": {
          "$ref": "#/$defs/Routing",
          "description": "HTTP routing. The API fills omitted fields. Needs port."
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Hostnames routed to the service. The first is primary. Platform domains end in an active platform domain. Needs port."
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Plain environment variables with their values."
        },
        "secrets": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Names of secrets the service needs. Values live in the environment and are set with loco env push."
        },
        "regions": {
          "additionalProperties": {
            "$ref": "#/$defs/Region"
          },
          "type": "object",
          "description": "Regions the service runs in keyed by region name. At least one."
        },
        "environments": {
          "additionalProperties": {
            "$ref": "#/$defs/Override"
          },
          "type": "object",
          "description": "Per-environment overrides keyed by environment name."
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1,
          "description": "Positive numeric UID for the application process. Omitted uses the image user.",
          "maximum": 2147483647
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1,
          "description": "Positive numeric primary GID for the application process. Omitted uses the image group.",
          "maximum": 2147483647
        },
        "deploy": {
          "$ref": "#/$defs/Deploy",
          "description": "How often the API sends a deployment a cluster fails to apply before marking it failed. The API fills omitted fields. Applies to every environment."
        },
        "observability": {
          "$ref": "#/$defs/Observability",
          "description": "Automatic OpenTelemetry SDK environment configuration, enabled by default."
        }
      },
      "dependentRequired": {
        "domains": ["port"],
        "health": ["port"],
        "routing": ["port"]
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "injectOtel": {
          "type": "boolean",
          "description": "Inject OpenTelemetry SDK environment defaults. Defaults to true."
        }
      }
    },
    "OverrideObservability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "injectOtel": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Override SDK environment injection; null removes this setting from the resolved configuration."
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Schema version. Always 1."
    },
    "partial": {
      "type": "string",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Name of the slice of the workspace this file owns. A DNS label."
    },
    "services": {
      "additionalProperties": {
        "$ref": "#/$defs/Service"
      },
      "propertyNames": {
        "maxLength": 63,
        "pattern": "[A-Za-z0-9]"
      },
      "type": "object",
      "description": "Services keyed by name. The name is the identity: renaming is a delete and a create. The private hostname and generated subdomain use the name's slug: lowercase letters and digits, with other runs replaced by one hyphen."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "partial",
    "services"
  ],
  "title": "loco.yaml",
  "description": "Services a Loco workspace runs, with per-environment overrides."
}
