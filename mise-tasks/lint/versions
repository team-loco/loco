#!/usr/bin/env bash
#MISE description="Check that every container image is pinned by tag and digest, that the Dockerfile base images use the Go, bun, uv and Python versions pinned in mise.toml, and that docs/pyproject.toml requires that Python minor version"
set -euo pipefail

status=0
dockerfiles=$(git ls-files '*Dockerfile' | grep -v '^examples/')

check() {
	local image=$1 want=$2 file line tag
	while IFS= read -r file; do
		while IFS= read -r line; do
			tag=${line#*"$image:"}
			tag=${tag%%[ @-]*}
			if [[ $tag != "$want" ]]; then
				echo "$file: $image:$tag, but mise.toml pins $want"
				status=1
			fi
		done < <(grep -E "^FROM[[:space:]]+$image:" "$file" || true)
	done <<<"$dockerfiles"
}

pinned() {
	local where=$1 image=$2
	if [[ ! $image =~ ^[^@]+:[^@:]+@sha256:[a-f0-9]{64}$ ]]; then
		echo "$where: $image is not pinned by tag and digest"
		status=1
	fi
}

while IFS= read -r file; do
	stages=" scratch "
	while read -r _ image rest; do
		[[ $image == --* ]] && read -r image rest <<<"$rest"
		if [[ $stages != *" $image "* ]]; then
			pinned "$file" "$image"
		fi
		read -r keyword stage _ <<<"$rest"
		if [[ $keyword == [Aa][Ss] ]]; then
			stages+="$stage "
		fi
	done < <(grep -E '^FROM[[:space:]]' "$file" || true)
done <<<"$dockerfiles"

while IFS= read -r file; do
	while IFS= read -r image; do
		pinned "$file" "$image"
	done < <(yq '.services[].image | select(. != null)' "$file")
done < <(git ls-files '*compose*.yaml' '*compose*.yml')

while IFS= read -r file; do
	while IFS= read -r image; do
		pinned "$file" "$image"
	done < <(yq '.jobs[] | (.services[]?.image, .container.image?) | select(. != null)' "$file")
done < <(git ls-files '.github/workflows/*.yml')

check golang "$(yq -p toml -oy '.tools.go' mise.toml)"
check oven/bun "$(yq -p toml -oy '.tools.bun' mise.toml)"
check ghcr.io/astral-sh/uv "$(yq -p toml -oy '.tools.uv' mise.toml)"
python=$(yq -p toml -oy '.tools.python' mise.toml)
check python "$python"
IFS=. read -r python_major python_minor _ <<<"$python"
requires_python=$(yq -p toml -oy '.project.requires-python' docs/pyproject.toml)
want_requires_python=">=$python_major.$python_minor,<$python_major.$((python_minor + 1))"
if [[ $requires_python != "$want_requires_python" ]]; then
	echo "docs/pyproject.toml: requires-python $requires_python, but mise.toml pins python $python"
	status=1
fi
if [[ $status -eq 0 ]]; then
	echo "Container images are pinned by tag and digest, and Dockerfile base images and docs requires-python match mise.toml"
fi
exit $status
