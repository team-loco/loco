#!/usr/bin/env bash
#MISE description="Lint and check formatting for every tracked Python file"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r -d '' file; do
	files+=("$file")
done < <(git ls-files -z -- '*.py')

ruff check "${files[@]}"
ruff format --check "${files[@]}"
