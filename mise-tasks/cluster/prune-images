#!/usr/bin/env bash
#MISE description="Check that the given images are on every kind node, then remove every other tag of them there, so rebuilds that kind loads onto every node do not pile up"
#USAGE arg "<image>..." var=#true help="image references to keep, such as loco-agent:tilt-0123abcd"
set -euo pipefail

cluster=${KIND_CLUSTER:-loco-cluster-local}
listed_timeout_seconds=30
listed_poll_seconds=1

normalize() {
	local ref=$1 first=${1%%/*}
	if [[ $ref != */* ]]; then
		echo "docker.io/library/$ref"
	elif [[ $first == *.* || $first == *:* || $first == localhost ]]; then
		echo "$ref"
	else
		echo "docker.io/$ref"
	fi
}

keep=()
for image in "$@"; do
	keep+=("$(normalize "$image")")
done

listed() {
	local node=$1 ref=$2 images
	images=$(docker exec "$node" crictl images -o json)
	KEEP="$ref" yq -p json -e '.images[] | select(.repoTags | any_c(. == strenv(KEEP)))' <<<"$images" >/dev/null 2>&1
}

nodes=$(kind get nodes --name "$cluster")
for node in $nodes; do
	for ref in "${keep[@]}"; do
		deadline=$((SECONDS + listed_timeout_seconds))
		until listed "$node" "$ref"; do
			if ((SECONDS >= deadline)); then
				echo "$ref is not on $node after ${listed_timeout_seconds}s, so nothing was pruned; the image was never loaded into the kind cluster" >&2
				exit 1
			fi
			sleep "$listed_poll_seconds"
		done
	done
done

for node in $nodes; do
	images=$(docker exec "$node" crictl images -o json)
	for ref in "${keep[@]}"; do
		stale=$(REPO="${ref%:*}" KEEP="$ref" yq -p json '
			.images[] |
			select(.repoTags | any_c(sub(":[^:/]*$"; "") == strenv(REPO))) |
			select(.repoTags | any_c(. == strenv(KEEP)) | not) |
			.id' <<<"$images")
		for id in $stale; do
			docker exec "$node" crictl rmi "$id" >/dev/null
			echo "removed an old ${ref%:*} image from $node"
		done
	done
done
