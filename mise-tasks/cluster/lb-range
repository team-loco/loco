#!/usr/bin/env bash
#MISE description="Print the first and last address of this stack's LoadBalancer range, carved from the top of the kind docker network: the top 50 addresses for slot 0, then 8 more for each slot below them"
set -euo pipefail

slot=${LOCO_STACK_SLOT:?}
reserved=6
main_size=50
slot_size=8

subnet=$(docker network inspect kind -f '{{range .IPAM.Config}}{{println .Subnet}}{{end}}' | grep -v : | head -n1)
prefix=${subnet#*/}

IFS=. read -r a b c d <<<"${subnet%/*}"
network=$(((a << 24) | (b << 16) | (c << 8) | d))
broadcast=$((network | ((1 << (32 - prefix)) - 1)))

last=$((broadcast - reserved))
size=$main_size
if [ "$slot" -ne 0 ]; then
	last=$((last - main_size - (slot - 1) * slot_size))
	size=$slot_size
fi
first=$((last - size + 1))
if [ "$first" -le $((network + 1)) ]; then
	echo "kind network $subnet is too small to carve slot $slot's LoadBalancer range from" >&2
	exit 1
fi

ip() {
	echo "$((($1 >> 24) & 255)).$((($1 >> 16) & 255)).$((($1 >> 8) & 255)).$(($1 & 255))"
}

echo "$(ip "$first") $(ip "$last")"
