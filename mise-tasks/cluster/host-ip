#!/usr/bin/env bash
#MISE description="Print the address pods in the local kind cluster reach the host on"
set -euo pipefail

ip=$(docker exec loco-cluster-local-control-plane getent ahostsv4 host.docker.internal | awk 'NR == 1 { print $1 }')
if [[ -z $ip ]]; then
	echo "host.docker.internal does not resolve on the kind nodes" >&2
	exit 1
fi
echo "$ip"
