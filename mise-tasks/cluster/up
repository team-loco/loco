#!/usr/bin/env bash
#MISE description="Create the local kind cluster, or recreate it if it is unreachable, export its kubeconfig, and point CoreDNS at resolvers pods can reach"
set -euo pipefail

name=loco-cluster-local
if kind get clusters 2>/dev/null | grep -qx "$name"; then
	if ! kubectl cluster-info --context "kind-$name" >/dev/null 2>&1; then
		echo "cluster exists but is unreachable, recreating..."
		kind delete cluster --name "$name"
		kind create cluster --config local-cluster.yml
	fi
else
	kind create cluster --config local-cluster.yml
fi
kind export kubeconfig --name "$name" --kubeconfig "$HOME/.kube/config"

corefile=$(kubectl --context "kind-$name" -n kube-system get configmap coredns -o jsonpath='{.data.Corefile}')
patched=${corefile//forward . \/etc\/resolv.conf/forward . 1.1.1.1 1.0.0.1}
if [[ $patched != "$corefile" ]]; then
	kubectl --context "kind-$name" -n kube-system create configmap coredns --from-literal=Corefile="$patched" --dry-run=client -o yaml |
		kubectl --context "kind-$name" -n kube-system replace -f -
	kubectl --context "kind-$name" -n kube-system rollout restart deployment/coredns
fi
