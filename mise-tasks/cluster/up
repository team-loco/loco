#!/usr/bin/env bash
#MISE description="Create the local kind cluster, start its nodes if mise run stop stopped them, or recreate it if it is unreachable, export its kubeconfig, and start the cloud-provider-kind container that gives the LoadBalancer Services of every kind cluster an address; a worktree's stack leaves the current kubectl context as it was"
#MISE env={_.source="dev/stack.sh"}
set -euo pipefail

name=$KIND_CLUSTER
api_ready_timeout_seconds=120
nodes_ready_timeout=180s
load_balancer_project=cloud-provider-kind
previous=$(kubectl config current-context 2>/dev/null || true)

if kind get clusters 2>/dev/null | grep -qx "$name"; then
	stopped=$(docker ps --quiet --filter "label=io.x-k8s.kind.cluster=$name" --filter status=exited)
	if [ -n "$stopped" ]; then
		echo "starting the stopped cluster nodes..."
		xargs docker start <<<"$stopped" >/dev/null
		for _ in $(seq "$api_ready_timeout_seconds"); do
			kubectl get --raw /readyz --context "kind-$name" >/dev/null 2>&1 && break
			sleep 1
		done
		kubectl wait --context "kind-$name" --for=condition=Ready nodes --all --timeout="$nodes_ready_timeout"
	fi
	if ! kubectl cluster-info --context "kind-$name" >/dev/null 2>&1; then
		echo "cluster exists but is unreachable, recreating..."
		kind delete cluster --name "$name"
		kind create cluster --config dev/kind-cluster.yml --name "$name"
	fi
else
	kind create cluster --config dev/kind-cluster.yml --name "$name"
fi
kind export kubeconfig --name "$name" --kubeconfig "$HOME/.kube/config"
docker compose --project-name "$load_balancer_project" --file dev/compose.cloud-provider-kind.yaml up --detach --wait
if [ "$LOCO_STACK_SLOT" -ne 0 ] && [ -n "$previous" ]; then
	kubectl config use-context "$previous" >/dev/null
fi
