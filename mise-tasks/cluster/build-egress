#!/usr/bin/env bash
#MISE description="Print builds.privateEgress as JSON: the kind network subnets on the registry and source bucket ports, taken from LOCO_REGISTRY_HOST and LOCO_SOURCE_BUCKET_ENDPOINT"
set -euo pipefail

registry_host=${LOCO_REGISTRY_HOST:?}
bucket_endpoint=${LOCO_SOURCE_BUCKET_ENDPOINT:?}
network=kind

port_of() {
	local port=${1##*:}
	if [ "$port" = "$1" ] || ! [[ $port =~ ^[0-9]+$ ]]; then
		echo "$2 has no port: $1" >&2
		exit 1
	fi
	echo "$port"
}

registry_port=$(port_of "$registry_host" LOCO_REGISTRY_HOST)
bucket_authority=${bucket_endpoint#*://}
bucket_port=$(port_of "${bucket_authority%%/*}" LOCO_SOURCE_BUCKET_ENDPOINT)

subnets=$(docker network inspect "$network" --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}')
if [ -z "${subnets// /}" ]; then
	echo "the $network docker network has no subnets" >&2
	exit 1
fi

entries=()
for subnet in $subnets; do
	for port in $(printf '%s\n' "$registry_port" "$bucket_port" | sort -un); do
		entries+=("{\"cidr\":\"$subnet\",\"port\":$port}")
	done
done
(IFS=,; echo "[${entries[*]}]")
