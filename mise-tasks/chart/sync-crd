#!/usr/bin/env bash
#MISE description="Re-wrap the generated CRDs as loco-operator chart templates"
set -euo pipefail

sync_crd() {
	local plural=$1 condition=$2
	local chart_crd=charts/loco-operator/templates/crd/$plural.infra.loco.io.yaml
	local generated_crd=controller/config/crd/bases/infra.loco.io_$plural.yaml
	{
		printf '{{- if %s }}\n' "$condition"
		yq -P -I 4 '.' "$generated_crd" | sed '1{/^---$/d;}'
		printf '{{- end }}\n'
	} > "$chart_crd"
	echo "synced $chart_crd"
}

sync_crd applications '.Values.crd.enable'
sync_crd builds 'and .Values.crd.enable .Values.builds.enabled'
