#!/usr/bin/env bash
#MISE description="Copy the generated controller RBAC into the loco-worker chart's roles for each controller"
set -euo pipefail

controller_role=charts/loco-worker/templates/controller/manager-role.yaml
generated_controller_role=controller/config/rbac/role.yaml

{
	printf '{{- if include "loco-worker.runsApps" . }}\n'
	yq -P -I 4 '.metadata.name = "loco-controller"' "$generated_controller_role" | sed '1{/^---$/d;}'
	printf '{{- end }}\n'
} > "$controller_role"
echo "synced $controller_role"

build_role=charts/loco-worker/templates/builds/manager-role.yaml
generated_build_role=controller/config/rbac/builds/role.yaml
namespace_placeholder=LOCO_BUILD_NAMESPACE

{
	printf '{{- if include "loco-worker.runsBuilds" . }}\n'
	yq -P -I 4 "
		.metadata.name = \"loco-build-controller\" |
		(select(.kind == \"Role\") | .metadata.namespace) = \"$namespace_placeholder\"
	" "$generated_build_role" |
		sed '1{/^---$/d;}' |
		sed "s/$namespace_placeholder/{{ .Values.builds.namespace }}/"
	printf '{{- end }}\n'
} > "$build_role"
echo "synced $build_role"
