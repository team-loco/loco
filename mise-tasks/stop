#!/usr/bin/env bash
#MISE description="Stop this checkout's host dashboard, fixtures and kind node while retaining installation state"
set -euo pipefail
mise run services:stop
docker compose --file dev/compose.local.yaml stop
nodes=$(kind get nodes --name "$KIND_CLUSTER" 2>/dev/null)
if [ -n "$nodes" ]; then
  xargs docker stop --time 120 <<<"$nodes" >/dev/null
fi
