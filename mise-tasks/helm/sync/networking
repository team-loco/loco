#!/usr/bin/env bash
#MISE description="Sync the networking phase (Cilium) to the local cluster"
#MISE env={_.file=".env"}
set -euo pipefail

KIND_API_SERVER_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' loco-cluster-local-control-plane 2>/dev/null | tr -d '\n')
export KIND_API_SERVER_IP
helmfile -e local -l phase=1-networking sync
