#!/usr/bin/env bash
#MISE description="Fix lint violations and format every tracked Python file"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r -d '' file; do
	files+=("$file")
done < <(git ls-files -z -- '*.py')

status=0
ruff check --fix "${files[@]}" || status=$?
ruff format "${files[@]}"
exit "$status"
