#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
values="$root/charts/loco-control-plane/values.yaml"
user=loco_dev
password=loco-dev-clickhouse
ready_attempts=120
config_dir="$root/observability-proxy/bin/clickhouse"
if ! docker ps --format '{{.Names}}' | grep -qx "$CLICKHOUSE_CONTAINER"; then
    docker rm -f "$CLICKHOUSE_CONTAINER" >/dev/null 2>&1 || true
    mkdir -p "$config_dir"
    printf '<clickhouse>%s</clickhouse>\n' "$(yq '.clickhouse.clickhouse.keeperConfig' "$values")" >"$config_dir/keeper.xml"
    chmod a+r "$config_dir/keeper.xml"
    docker run -d --name "$CLICKHOUSE_CONTAINER" -p "127.0.0.1:$CLICKHOUSE_NATIVE_PORT:9000" \
        -e CLICKHOUSE_USER="$user" -e CLICKHOUSE_PASSWORD="$password" -e CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 \
        -v "$CLICKHOUSE_CONTAINER:/var/lib/clickhouse" \
        -v "$config_dir/keeper.xml:/etc/clickhouse-server/config.d/keeper.xml:ro" \
        "$(yq '.clickhouse.clickhouse.image.repository + ":" + .clickhouse.clickhouse.image.tag' "$values")" >/dev/null
fi
for _ in $(seq "$ready_attempts"); do
    docker exec "$CLICKHOUSE_CONTAINER" clickhouse-client --user "$user" --password "$password" -q "SELECT 1" >/dev/null 2>&1 && break
    sleep 1
done
docker exec "$CLICKHOUSE_CONTAINER" clickhouse-client --user "$user" --password "$password" -q "SELECT 1" >/dev/null
dsn="clickhouse://$user:$password@127.0.0.1:$CLICKHOUSE_NATIVE_PORT"
PORT="$OBS_PROXY_PORT" CONTROL_PLANE_URL="$PUBLIC_API_URL" CLICKHOUSE_URL="$dsn" CLICKHOUSE_MIGRATOR_URL="$dsn" \
    INGEST_ENABLED=true CLICKHOUSE_INGEST_URL="$dsn" OTLP_GRPC_PORT="$OBS_OTLP_GRPC_PORT" OTLP_HTTP_PORT="$OBS_OTLP_HTTP_PORT" \
    exec "$root/observability-proxy/bin/loco-obs-proxy"
