#!/usr/bin/env bash
#MISE description="Build the API, agent, observability proxy and CLI binaries the end-to-end tests run, and under <bin-dir>/images the controller, builder and observability proxy binaries their images package for the Docker host's platform, concurrently: e2e:build <bin-dir> <version>"
set -euo pipefail

if [[ $# -ne 2 ]]; then
	echo "usage: mise run e2e:build <bin-dir> <version>" >&2
	exit 2
fi
mkdir -p "$1"
bin_dir=$(cd "$1" && pwd)
ldflags="-X main.version=$2"
root=$(git rev-parse --show-toplevel)
log_dir=$(mktemp -d)
image_platform=$(docker version --format '{{.Server.Os}} {{.Server.Arch}}')
read -r image_os image_arch <<<"$image_platform"
image_env=(CGO_ENABLED=0 GOOS="$image_os" GOARCH="$image_arch")
binaries=()
pids=()

stop_builds() {
	local pid
	for pid in ${pids[@]+"${pids[@]}"}; do
		pkill -P "$pid" 2>/dev/null || true
		kill "$pid" 2>/dev/null || true
	done
	rm -rf "$log_dir"
}
trap stop_builds EXIT

build() {
	local name=$1 module=$2 binary=$3 package=$4
	shift 4
	echo "Building ${name}..."
	(cd "$root/$module" && env "$@" go build -ldflags "$ldflags" -o "$bin_dir/$binary" "$package") >"$log_dir/${binary//\//-}.log" 2>&1 &
	binaries+=("$binary")
	pids+=("$!")
}

build API api loco-api .
build Agent agent loco-agent .
build "Observability Proxy" observability-proxy loco-obs-proxy .
build "the CLI" cmd/loco loco .
build "the operator CLI" cmd/locoadm locoadm .
build "the controller image's manager" controller images/manager ./cmd "${image_env[@]}"
build "the builder image's builder" builder images/loco-builder . "${image_env[@]}" GOFLAGS=-trimpath
build "the observability proxy image's proxy" observability-proxy images/loco-obs-proxy . "${image_env[@]}"

failed=0
for i in "${!pids[@]}"; do
	if wait "${pids[$i]}"; then
		echo "Built ${binaries[$i]}"
		cat "$log_dir/${binaries[$i]//\//-}.log"
	else
		echo "Building ${binaries[$i]} failed:" >&2
		cat "$log_dir/${binaries[$i]//\//-}.log" >&2
		failed=1
	fi
done
pids=()
exit "$failed"
