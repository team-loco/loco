#!/usr/bin/env bash
#MISE description="Sync one release to the local cluster with extra values, overriding fields another field manager owns, remove the older tags of its images from the kind nodes, and print the objects it deployed; Tilt runs this for every release that uses an image it builds"
#USAGE arg "<release>" help="release name, such as loco-worker"
#USAGE arg "<namespace>" help="namespace the release is installed in"
#USAGE arg "[values]..." var=#true help="extra values, each passed to helm as --set"
set -euo pipefail

release=$1
namespace=$2
shift 2

mise run helm:sync:release "$release" "$@" >&2

deployed=()
for image in $(compgen -v | grep -xE 'TILT_IMAGE_[0-9]+'); do
	deployed+=("${!image}")
done
mise run cluster:prune-images "${deployed[@]}" >&2

helm get manifest "$release" -n "$namespace" --kube-context "kind-$KIND_CLUSTER" |
	yq "select(. != null) | .metadata.namespace = (.metadata.namespace // \"$namespace\")" |
	kubectl --context "kind-$KIND_CLUSTER" get -o yaml -f -
