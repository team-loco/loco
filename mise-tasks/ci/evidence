#!/usr/bin/env bash
#MISE description="Run tests/ui suites and before/after screenshots of this branch's pushed head in CI, wait for that run and download its evidence into DIR; exits non-zero when the run fails: ci:evidence --out DIR [--shots FILE] [--scenario FILE] [--base REF] [suite...]"
set -euo pipefail

usage="usage: mise run ci:evidence --out DIR [--shots FILE] [--scenario FILE] [--base REF] [suite...]"
out='' shots='' scenario='' base=main shots_file='' scenario_file=''
input_limit=64000
encode() { jq -c . "$1" | gzip -9 -n | base64 | tr -d '\n'; }
suites=()
while [[ $# -gt 0 ]]; do
	case $1 in
	--out | --shots | --scenario | --base)
		[[ $# -ge 2 ]] || {
			echo "$usage" >&2
			exit 2
		}
		case $1 in
		--out) out=$2 ;;
		--shots) shots_file=$2 shots=$(encode "$2") ;;
		--scenario) scenario_file=$2 scenario=$(encode "$2") ;;
		--base) base=$2 ;;
		esac
		shift 2
		;;
	-*)
		echo "$usage" >&2
		exit 2
		;;
	*)
		suites+=("$1")
		shift
		;;
	esac
done
if [[ -z $out || (-z $shots && ${#suites[@]} -eq 0) ]]; then
	echo "$usage" >&2
	exit 2
fi

if [[ -n $shots ]]; then
	check=(--spec "$shots_file")
	if [[ -n $scenario_file ]]; then check+=(--scenario "$scenario_file"); fi
	uv run --frozen --project tests python tests/ui/evidence.py check "${check[@]}"
	size=$((${#shots} + ${#scenario}))
	echo "encoded inputs: $size of $input_limit bytes"
	if ((size > input_limit)); then
		echo "over the limit; move mocks shared by several shots into the spec-level respond list" >&2
		exit 1
	fi
fi

branch=$(git symbolic-ref --short HEAD)
head=$(git rev-parse HEAD)
pushed=$(git ls-remote origin "refs/heads/$branch" | cut -f1)
if [[ $pushed != "$head" ]]; then
	echo "CI runs origin's $branch (${pushed:-missing}); push this checkout's $head first" >&2
	exit 1
fi

key=$(printf '%s\0' "${suites[*]-}" "$shots" "$scenario" "$base" | git hash-object --stdin | cut -c1-10)
run=$(gh run list --workflow evidence.yml --branch "$branch" --limit 50 --json displayTitle,status,databaseId,url \
	--jq ".[] | select(.displayTitle == \"Evidence $head $key\" and .status != \"completed\") | \"\(.databaseId) \(.url)\"" | head -n1)
if [[ -z $run ]]; then
	run=$(gh api --method POST "repos/{owner}/{repo}/actions/workflows/evidence.yml/dispatches" \
		-f ref="$branch" -F return_run_details=true \
		-f "inputs[suites]=${suites[*]-}" -f "inputs[shots]=$shots" -f "inputs[scenario]=$scenario" -f "inputs[base]=$base" -f "inputs[key]=$key" \
		--jq '"\(.workflow_run_id) \(.html_url)"')
fi
id=${run%% *}
echo "Evidence run: ${run#* }"

until status=$(gh run view "$id" --json status --jq .status 2>/dev/null) && [[ $status == completed ]]; do
	echo "Run $id not readable or not finished yet; asking again in 30s" >&2
	sleep 30
done
conclusion=$(gh run view "$id" --json conclusion --jq .conclusion)

mkdir -p "$out"
# gh refuses to overwrite files, so it downloads into an empty directory and the files are copied over $out.
download=$(mktemp -d)
trap 'rm -rf "$download"' EXIT
gh run download "$id" --name evidence --dir "$download" || echo "Run $id uploaded no evidence" >&2
cp -R "$download"/. "$out"
echo "Run $id: $conclusion; evidence in $out"
if [[ $conclusion != success && -f $download/failure.md ]]; then cat "$download/failure.md" >&2; fi
[[ $conclusion == success ]]
