#!/usr/bin/env bash
#MISE description="Test the ClickHouse packages (telemetry queries, schema migrations, migration lock) and the observability proxy against the ClickHouse image and Keeper config the loco-control-plane chart pins; LOCO_TEST_CLICKHOUSE_URL reuses a running server with Keeper instead"
set -euo pipefail

root=$(git rev-parse --show-toplevel)
source "$root/mise-tasks/test/lib/clickhouse.sh"

go -C "$root" test -v ./internal/clickhouse/... "$@"
cd "$root/observability-proxy"
go test -v -coverprofile=coverage.out ./... "$@"
