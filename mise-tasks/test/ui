#!/usr/bin/env bash
#MISE description="Build the API and production UI of this checkout once, start one OpenBao, then run the dashboard suites in tests/ui, each with its own API process, database and seed: every *_ui.py (Chromium) and *_api.py file, or the named suites. Suites run --jobs at a time (default: one per two CPUs), longest first by tests/ui/durations; each suite's output prints when it ends. --shard i/N runs the ith of N shards of equal expected duration: test:ui [suite...] [--shard i/N] [--jobs N]"
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
usage="usage: mise run test:ui [suite...] [--shard i/N] [--jobs N]"
suites=()
shard=1/1
jobs=$(($(getconf _NPROCESSORS_ONLN) / 2))
if ((jobs < 1)); then jobs=1; fi
while [[ $# -gt 0 ]]; do
	case $1 in
	--shard | --jobs)
		[[ $# -ge 2 ]] || {
			echo "$usage" >&2
			exit 2
		}
		if [[ $1 == --shard ]]; then shard=$2; else jobs=$2; fi
		shift 2
		;;
	*)
		suites+=("$1")
		shift
		;;
	esac
done
if [[ ${#suites[@]} -eq 0 ]]; then
	while IFS= read -r file; do
		suites+=("$(basename "$file" .py)")
	done < <(ls tests/ui/*_ui.py tests/ui/*_api.py)
fi
if [[ ! $shard =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || ((BASH_REMATCH[1] > BASH_REMATCH[2])); then
	echo "--shard takes i/N with 1 <= i <= N, got '$shard'" >&2
	exit 2
fi
index=${BASH_REMATCH[1]} count=${BASH_REMATCH[2]}
if [[ ! $jobs =~ ^[1-9][0-9]*$ ]]; then
	echo "--jobs takes a positive number, got '$jobs'" >&2
	exit 2
fi

for suite in "${suites[@]}"; do
	if [[ ! -f tests/ui/$suite.py ]]; then
		echo "No suite tests/ui/$suite.py" >&2
		exit 2
	fi
done

# Longest first, each suite to the shard with the least expected time; a suite missing from the file counts 10s.
selected=()
while IFS= read -r suite; do
	selected+=("$suite")
done < <(
	printf '%s\n' "${suites[@]}" |
		awk 'NR == FNR { if ($1 !~ /^#/) seconds[$2] = $1; next } { print ($1 in seconds ? seconds[$1] : 10), $1 }' tests/ui/durations - |
		sort -k1,1nr -k2,2 |
		awk -v shard="$index" -v count="$count" '{
			best = 1
			for (s = 2; s <= count; s++) if (load[s] < load[best]) best = s
			load[best] += $1
			if (best == shard) print $2
		}'
)
suites=(${selected[@]+"${selected[@]}"})
if ((jobs > ${#suites[@]})); then jobs=${#suites[@]}; fi

if git grep -nE 'expect_response|wait_for_response|networkidle' -- 'tests/ui/*.py' ':!tests/ui/harness.py'; then
	echo "Wait with harness.expect_rpc on the request body, or for the outcome on screen." >&2
	exit 1
fi
uv run --frozen --project tests pytest tests/ui/test_evidence.py

evidence=(uv run --frozen --project tests python tests/ui/evidence.py)
logs=$(mktemp -d)
start=$SECONDS
# The suites share one OpenBao. It holds only the seeded transit keys; each API
# keeps what it encrypts or signs with them in its own database.
cleanup() {
	status=$?
	"${evidence[@]}" stop-openbao --address "${UI_EVIDENCE_OPENBAO:-}" || status=1
	rm -rf "$logs"
	exit "$status"
}
trap cleanup EXIT
UI_EVIDENCE_OPENBAO=$("${evidence[@]}" openbao)
export UI_EVIDENCE_OPENBAO
"${evidence[@]}" build
echo "Built the API and UI and started OpenBao in $((SECONDS - start))s"

# Each finished suite writes "name status seconds" to this pipe.
mkfifo "$logs/done"
exec 3<>"$logs/done"
run_suite() {
	local suite=$1 start=$SECONDS status=0 out=/dev/stdout
	if ((jobs > 1)); then out=$logs/$suite.log; fi
	uv run --frozen --project tests python "tests/ui/$suite.py" >"$out" 2>&1 || status=$?
	echo "$suite $status $((SECONDS - start))" >&3
}
# Run every selected suite even after a failure, so one run reports them all.
failed=()
running=0
finish_one() {
	local suite status seconds
	read -r suite status seconds <&3
	running=$((running - 1))
	if ((jobs > 1)); then
		echo "::group::$suite"
		cat "$logs/$suite.log"
		echo "::endgroup::"
	fi
	if ((status == 0)); then
		echo "$suite passed in ${seconds}s"
	else
		echo "$suite failed in ${seconds}s"
		failed+=("$suite")
	fi
}
start=$SECONDS
for suite in ${suites[@]+"${suites[@]}"}; do
	if ((running == jobs)); then finish_one; fi
	run_suite "$suite" &
	running=$((running + 1))
done
while ((running > 0)); do finish_one; done
wait
echo "Ran ${#suites[@]} suites, $jobs at a time, in $((SECONDS - start))s"
if [[ ${#failed[@]} -gt 0 ]]; then
	echo "Failed suites: ${failed[*]}" >&2
	exit 1
fi
