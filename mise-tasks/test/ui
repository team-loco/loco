#!/usr/bin/env bash
#MISE description="Build the API and production UI of this checkout once (a clean checkout reuses its commit's cached build), then run the dashboard suites in tests/ui, each with its own API process, database and seed on the OpenBao and Postgres server every run on the machine shares: every *_ui.py (Chromium) and *_api.py file, or the named suites. Suites run --jobs at a time (default: one per two CPUs), longest first by tests/ui/durations; each suite's output prints when it ends; a suite named n times runs n times. --shard i/N runs the ith of N shards of equal expected duration: test:ui [suite...] [--shard i/N] [--jobs N]"
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
usage="usage: mise run test:ui [suite...] [--shard i/N] [--jobs N]"
suites=()
shard=1/1
jobs=$(($(getconf _NPROCESSORS_ONLN) / 2))
if ((jobs < 1)); then jobs=1; fi
while [[ $# -gt 0 ]]; do
	case $1 in
	--shard | --jobs)
		[[ $# -ge 2 ]] || {
			echo "$usage" >&2
			exit 2
		}
		if [[ $1 == --shard ]]; then shard=$2; else jobs=$2; fi
		shift 2
		;;
	*)
		suites+=("$1")
		shift
		;;
	esac
done
if [[ ${#suites[@]} -eq 0 ]]; then
	while IFS= read -r file; do
		suites+=("$(basename "$file" .py)")
	done < <(ls tests/ui/*_ui.py tests/ui/*_api.py)
fi
if [[ ! $shard =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || ((BASH_REMATCH[1] > BASH_REMATCH[2])); then
	echo "--shard takes i/N with 1 <= i <= N, got '$shard'" >&2
	exit 2
fi
index=${BASH_REMATCH[1]} count=${BASH_REMATCH[2]}
if [[ ! $jobs =~ ^[1-9][0-9]*$ ]]; then
	echo "--jobs takes a positive number, got '$jobs'" >&2
	exit 2
fi

for suite in "${suites[@]}"; do
	if [[ ! -f tests/ui/$suite.py ]]; then
		echo "No suite tests/ui/$suite.py" >&2
		exit 2
	fi
done

# Longest first, each suite to the shard with the least expected time; a suite missing from the file counts 10s.
selected=()
while IFS= read -r suite; do
	selected+=("$suite")
done < <(
	printf '%s\n' "${suites[@]}" |
		awk 'NR == FNR { if ($1 !~ /^#/) seconds[$2] = $1; next } { print ($1 in seconds ? seconds[$1] : 10), $1 }' tests/ui/durations - |
		sort -k1,1nr -k2,2 |
		awk -v shard="$index" -v count="$count" '{
			best = 1
			for (s = 2; s <= count; s++) if (load[s] < load[best]) best = s
			load[best] += $1
			if (best == shard) print $2
		}'
)
suites=(${selected[@]+"${selected[@]}"})
if ((jobs > ${#suites[@]})); then jobs=${#suites[@]}; fi

# A suite named n times runs n times; runs after the first are labelled name#2, name#3.
runs=()
for suite in ${suites[@]+"${suites[@]}"}; do
	seen=0
	for run in ${runs[@]+"${runs[@]}"}; do
		if [[ ${run%%#*} == "$suite" ]]; then seen=$((seen + 1)); fi
	done
	if ((seen == 0)); then runs+=("$suite"); else runs+=("$suite#$((seen + 1))"); fi
done

if git grep -nE 'expect_response|wait_for_response|networkidle' -- 'tests/ui/*.py' ':!tests/ui/harness.py'; then
	echo "Wait with harness.expect_rpc on the request body, or for the outcome on screen." >&2
	exit 1
fi
uv run --frozen --project tests pytest tests/ui/test_evidence.py

evidence=(uv run --frozen --project tests python tests/ui/evidence.py)
logs=$(mktemp -d)
start=$SECONDS
trap 'rm -rf "$logs"' EXIT
# A clean checkout reuses its commit's cached build; uncommitted changes build in place.
UI_EVIDENCE_BUILD=$("${evidence[@]}" build)
export UI_EVIDENCE_BUILD
echo "Built the API and UI in $((SECONDS - start))s"

# Each finished suite writes "name status seconds" to this pipe.
mkfifo "$logs/done"
exec 3<>"$logs/done"
run_suite() {
	local run=$1 start=$SECONDS status=0 out=/dev/stdout
	if ((jobs > 1)); then out=$logs/$run.log; fi
	uv run --frozen --project tests python "tests/ui/${run%%#*}.py" >"$out" 2>&1 || status=$?
	echo "$run $status $((SECONDS - start))" >&3
}
# Run every selected suite even after a failure, so one run reports them all.
failed=()
running=()
finish_one() {
	local heartbeat run status seconds name rest=()
	# A background loop reports progress while this read blocks for the whole line.
	while sleep 60 >/dev/null; do echo "still running: ${running[*]}"; done &
	heartbeat=$!
	read -r run status seconds <&3
	kill "$heartbeat" 2>/dev/null || true
	wait "$heartbeat" 2>/dev/null || true
	for name in "${running[@]}"; do
		if [[ $name != "$run" ]]; then rest+=("$name"); fi
	done
	running=(${rest[@]+"${rest[@]}"})
	if ((jobs > 1)); then
		echo "::group::$run"
		cat "$logs/$run.log"
		echo "::endgroup::"
	fi
	if ((status == 0)); then
		echo "$run passed in ${seconds}s"
	else
		echo "$run failed in ${seconds}s"
		failed+=("$run")
	fi
}
start=$SECONDS
for run in ${runs[@]+"${runs[@]}"}; do
	if ((${#running[@]} == jobs)); then finish_one; fi
	run_suite "$run" &
	running+=("$run")
done
while ((${#running[@]} > 0)); do finish_one; done
wait
echo "Ran ${#runs[@]} suites, $jobs at a time, in $((SECONDS - start))s"
if [[ ${#failed[@]} -gt 0 ]]; then
	echo "Failed suites: ${failed[*]}" >&2
	exit 1
fi
