#!/usr/bin/env bash
#MISE description="Render the loco-worker chart with builds on and off and check which controller objects it renders, and that it renders no CRDs"
#MISE depends=["helm:deps"]
set -euo pipefail

chart=charts/loco-worker
release=loco-worker
tag=chart-test
required=("--set=agent.image.tag=$tag" "--set=certManager.issuer.email=chart-test@example.test"
	"--set=global.region=chart-test" "--set=global.exporter.endpoint=https://ingest.chart-test.example.test")
tags=("--set=controller.image.tag=$tag" "--set=builds.builderImage.tag=$tag")
failures=0

render() {
	helm template "$release" "$chart" --namespace loco-system "${required[@]}" --include-crds "${tags[@]}" "$@" |
		yq -N '.kind + "/" + .metadata.name'
}

expect() {
	local mode=$1 want=$2 object=$3 objects=$4
	if grep -qxF "$object" <<<"$objects"; then
		[ "$want" = present ] && return 0
		echo "FAIL: $mode renders $object"
	else
		[ "$want" = absent ] && return 0
		echo "FAIL: $mode does not render $object"
	fi
	failures=$((failures + 1))
}

build_objects=(
	Namespace/loco-builds
	Deployment/loco-build-controller
	ServiceAccount/loco-build-controller
	ClusterRole/loco-build-controller
	ClusterRoleBinding/loco-build-controller
	Role/loco-build-controller
	RoleBinding/loco-build-controller
	RoleBinding/loco-build-controller-leader-election
	Role/loco-agent-builds
	RoleBinding/loco-agent-builds
)
controller_objects=(
	Deployment/loco-controller
	ServiceAccount/loco-controller
	ClusterRole/loco-controller
	ClusterRoleBinding/loco-controller
)

enabled=$(render)
disabled=$(render --set builds.enabled=false)

for object in "${controller_objects[@]}"; do
	expect "builds.enabled=true" present "$object" "$enabled"
	expect "builds.enabled=false" present "$object" "$disabled"
done
for object in "${build_objects[@]}"; do
	expect "builds.enabled=true" present "$object" "$enabled"
	expect "builds.enabled=false" absent "$object" "$disabled"
done
if grep -q '^CustomResourceDefinition/' <<<"$enabled$disabled"; then
	echo "FAIL: the chart renders a CustomResourceDefinition; mise run crds:apply owns them"
	failures=$((failures + 1))
fi

disabled_manifest=$(helm template "$release" "$chart" --namespace loco-system "${required[@]}" "${tags[@]}" --set builds.enabled=false)
for term in LOCO_BUILD_CONFIG loco-builder moby/buildkit 'kind: Build$'; do
	if grep -qE "$term" <<<"$disabled_manifest"; then
		echo "FAIL: builds.enabled=false still mentions $term"
		failures=$((failures + 1))
	fi
done
if grep -qE -- '- builds(/status|/finalizers)?$' <<<"$disabled_manifest"; then
	echo "FAIL: builds.enabled=false still grants access to Builds"
	failures=$((failures + 1))
fi

controller_role=$(helm template "$release" "$chart" --namespace loco-system "${required[@]}" "${tags[@]}" \
	--show-only templates/controller/manager-role.yaml)
for resource in builds jobs; do
	if grep -qE -- "- $resource(/.*)?$" <<<"$controller_role"; then
		echo "FAIL: the Application controller's role grants $resource"
		failures=$((failures + 1))
	fi
done
pod_verbs=$(yq -N '.rules[] | select(.resources[] == "pods") | .verbs[]' <<<"$controller_role" | sort -u | tr '\n' ' ')
if [ "$pod_verbs" != "get list watch " ]; then
	echo "FAIL: the Application controller's role grants pods verbs other than get, list and watch: $pod_verbs"
	failures=$((failures + 1))
fi

with_secrets=$(render --set builds.pushSecretName=push --set registry.pullSecretName=pull)
expect "with registry secrets" present Role/loco-build-controller-registry-secrets "$with_secrets"
expect "without registry secrets" absent Role/loco-build-controller-registry-secrets "$enabled"

controller_image=$(helm template "$release" "$chart" --namespace loco-system "${required[@]}" "${tags[@]}" \
	--show-only templates/controller/deployment.yaml | yq '.spec.template.spec.containers[0].image')
if [ "$controller_image" != "ghcr.io/team-loco/loco-controller:$tag" ]; then
	echo "FAIL: the controller runs $controller_image, not the tag it was given"
	failures=$((failures + 1))
fi
for value in controller.image.tag builds.builderImage.tag; do
	others=()
	for set in "${tags[@]}"; do
		[[ $set == "--set=$value="* ]] || others+=("$set")
	done
	missing=$(helm template "$release" "$chart" --namespace loco-system "${required[@]}" "${others[@]}" 2>&1 >/dev/null || true)
	if ! grep -qF "$value is required" <<<"$missing"; then
		echo "FAIL: the chart renders without $value"
		failures=$((failures + 1))
	fi
done

if [ "$failures" -gt 0 ]; then
	echo "$failures chart render check(s) failed"
	exit 1
fi
echo "chart render checks passed"
