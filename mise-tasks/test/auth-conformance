#!/usr/bin/env bash
#MISE description="Run the auth contract against Supabase Auth, Keycloak, Zitadel and Dex"
set -euo pipefail

source "$(git rev-parse --show-toplevel)/mise-tasks/test/lib/auth-stack.sh"
auth_stack_up
for _ in $(seq 1 120); do
	[ -s "$CONFORMANCE_ZITADEL_BOOTSTRAP/admin.pat" ] && [ -s "$CONFORMANCE_ZITADEL_BOOTSTRAP/login-client.pat" ] && break
	sleep 1
done
cd api
LOCO_CONFORMANCE_ZITADEL_BOOTSTRAP="$CONFORMANCE_ZITADEL_BOOTSTRAP" \
	go test -tags conformance -count=1 -run TestProviderConformance -v ./auth/ "$@"
