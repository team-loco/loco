#!/usr/bin/env bash
#MISE description="Run the auth contract and SAML SSO against Supabase Auth, Keycloak, Dex and a SAML IdP"
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
compose=(docker compose -f "$root/env/conformance/compose.yaml")
keys=$(go run ./tools/authkeys)
set -a
eval "$keys"
set +a
if [ "${KEEP:-}" = "" ]; then
	trap '"${compose[@]}" down -v >/dev/null 2>&1' EXIT
fi
"${compose[@]}" up -d --wait --build
for url in http://localhost:55556/dex/.well-known/openid-configuration \
	http://localhost:58081/simplesaml/saml2/idp/metadata.php; do
	for _ in $(seq 1 60); do
		curl -sf -o /dev/null "$url" && break
		sleep 1
	done
done
cd api
LOCO_TEST_DATABASE_URL="postgres://loco_test:loco_test@localhost:${CONFORMANCE_POSTGRES_PORT:-55440}/loco_test?sslmode=disable" \
	go test -tags conformance -count=1 -run Conformance -v ./auth/ ./service/ "$@"
