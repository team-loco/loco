#!/usr/bin/env bash
#MISE description="Generate the local identity provider keys into .env, once"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
touch .env
if ! grep -q '^GOTRUE_JWT_KEYS=' .env; then
	keys=$(go run ./tools/authkeys)
	printf '\n%s\n' "$keys" >>.env
	echo "✓ wrote the identity provider keys to .env"
	exit 0
fi
if ! grep -q '^AUTH_SUPABASE_SERVICE_KEY=' .env; then
	jwt_keys=$(grep '^GOTRUE_JWT_KEYS=' .env | head -n1 | cut -d= -f2- | sed "s/^'//; s/'$//")
	key=$(GOTRUE_JWT_KEYS="$jwt_keys" go run ./tools/authkeys service-role)
	printf '%s\n' "$key" >>.env
	echo "✓ wrote AUTH_SUPABASE_SERVICE_KEY to .env"
	exit 0
fi
echo "✓ identity provider keys already in .env"
