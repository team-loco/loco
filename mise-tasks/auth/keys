#!/usr/bin/env bash
#MISE description="Generate the local identity provider keys into .env, once"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
touch .env
if grep -q '^GOTRUE_JWT_KEYS=' .env; then
	echo "✓ identity provider keys already in .env"
	exit 0
fi
keys=$(go run ./tools/authkeys)
printf '\n%s\n' "$keys" >>.env
echo "✓ wrote GOTRUE_JWT_KEYS, GOTRUE_JWT_SECRET and GOTRUE_SAML_PRIVATE_KEY to .env"
