#!/usr/bin/env bash
#MISE description="Stop the host dashboard on this checkout's web port"
set -euo pipefail
exit_timeout_seconds=10
listeners() {
  lsof -t -sTCP:LISTEN -iTCP:"$WEB_PORT" || true
}
pids=$(listeners)
if [ -z "$pids" ]; then
  exit 0
fi
xargs kill <<<"$pids"
for _ in $(seq "$exit_timeout_seconds"); do
  [ -z "$(listeners)" ] && exit 0
  sleep 1
done
echo "dashboard still listens on port $WEB_PORT after ${exit_timeout_seconds}s" >&2
exit 1
