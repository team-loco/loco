# Production environment values for loco-obs chart

# Gateway namespace where the Envoy Gateway is deployed
gatewayNamespace: loco-system

# ClickHouse configuration for production
clickhouse:
  enabled: true
  clickhouse:
    defaultUser:
      password: {{ requiredEnv "CLICKHOUSE_PASSWORD" | quote }}

clickhouseUserPasswords:
  loco_migrator: {{ requiredEnv "CLICKHOUSE_MIGRATOR_PASSWORD" | quote }}
  loco_ingest: {{ requiredEnv "CLICKHOUSE_INGEST_PASSWORD" | quote }}
  loco_reader: {{ requiredEnv "CLICKHOUSE_READER_PASSWORD" | quote }}

# Observability proxy (enabled by default)
obsProxy:
  enabled: true
  auth:
    existingSecret: {{ requiredEnv "OBS_PROXY_AUTH_SECRET" | quote }}
  image:
    tag: sha-{{ requiredEnv "GH_SHA" }}
  replicaCount: 2
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: 2000m
      memory: 2Gi
  controlPlane:
    url: {{ requiredEnv "CONTROL_PLANE_URL" | quote }}
