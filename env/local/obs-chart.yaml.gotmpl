gatewayNamespace: loco-system

clickhouse:
  enabled: true
  clickhouse:
    defaultUser:
      password: ""
    resources:
      requests:
        cpu: 250m
        memory: 1Gi
      limits:
        cpu: "1"
        memory: 2Gi

clickhouseUserPasswords:
  loco_migrator: {{ env "CLICKHOUSE_MIGRATOR_PASSWORD" | default "loco-local-migrator" | quote }}
  loco_ingest: {{ env "CLICKHOUSE_INGEST_PASSWORD" | default "loco-local-ingest" | quote }}
  loco_reader: {{ env "CLICKHOUSE_READER_PASSWORD" | default "loco-local-reader" | quote }}

obsProxy:
  enabled: true
  auth:
    existingSecret: {{ env "OBS_PROXY_AUTH_SECRET" | default "loco-obs-obs-proxy-auth" | quote }}
  controlPlane:
    url: "http://host.docker.internal:{{ requiredEnv "APP_PORT" | splitList ":" | last }}"
  clickhouse:
    retention:
      logs: 720h
      traces: 720h
      metrics: 720h
