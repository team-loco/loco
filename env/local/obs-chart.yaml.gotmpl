global:
  region: us-east-1

gatewayNamespace: loco-system

clickhouse:
  enabled: true
  clickhouse:
    defaultUser:
      password: ""
    resources:
      requests:
        cpu: 250m
        memory: 1Gi
      limits:
        cpu: "1"
        memory: 2Gi
    settings:
      mark_cache_size: "268435456"
      index_mark_cache_size: "67108864"
      primary_index_cache_size: "134217728"
      uncompressed_cache_size: "0"
      background_schedule_pool_size: "32"
      max_concurrent_queries: "100"

clickhouseUserPasswords:
  loco_migrator: {{ env "CLICKHOUSE_MIGRATOR_PASSWORD" | default "loco-local-migrator" | quote }}
  loco_ingest: {{ env "CLICKHOUSE_INGEST_PASSWORD" | default "loco-local-ingest" | quote }}
  loco_reader: {{ env "CLICKHOUSE_READER_PASSWORD" | default "loco-local-reader" | quote }}
  loco_workload_ingest: {{ env "CLICKHOUSE_WORKLOAD_INGEST_PASSWORD" | default "loco-local-workload-ingest" | quote }}
