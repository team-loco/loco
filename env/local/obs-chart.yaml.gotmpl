gatewayNamespace: loco-system

clickhouse:
  enabled: true
  defaultUser:
    password: ""

clickhouseUserPasswords:
  loco_migrator: {{ env "CLICKHOUSE_MIGRATOR_PASSWORD" | default "loco-local-migrator" | quote }}
  loco_ingest: {{ env "CLICKHOUSE_INGEST_PASSWORD" | default "loco-local-ingest" | quote }}
  loco_reader: {{ env "CLICKHOUSE_READER_PASSWORD" | default "loco-local-reader" | quote }}

otel-col-deploy:
  config:
    exporters:
      clickhouse:
        ttl: 720h

obsProxy:
  enabled: true
  controlPlane:
    url: "http://loco-core-agent.loco-system.svc.cluster.local:8000"
