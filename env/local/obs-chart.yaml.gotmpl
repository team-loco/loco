gatewayNamespace: loco-system

clickhouse:
  enabled: true
  defaultUser:
    password: ""

otel-col-deploy:
  config:
    exporters:
      clickhouse:
        ttl: 720h

obsProxy:
  enabled: true
  controlPlane:
    url: "http://host.docker.internal:{{ requiredEnv "APP_PORT" | splitList ":" | last }}"
