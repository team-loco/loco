manager:
  image:
    repository: loco-controller
    tag: latest
    pullPolicy: Never
registry:
  pullSecretName: loco-registry
builds:
  pushSecretName: loco-registry-push
  insecureRegistry: true
  privateEgressCIDRs:
  {{- range exec "mise" (list "run" "--quiet" "cluster:build-egress") | trim | splitList " " }}
    - {{ . | quote }}
  {{- end }}
  builderImage:
    repository: loco-builder
    tag: latest
    pullPolicy: Never
