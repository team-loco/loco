certManager:
  issuer:
    email: {{ env "CERT_MANAGER_EMAIL" | quote }}

global:
  domain:
    base: deploy-app.com
    wildcard: "*.deploy-app.com"
    ui: deploy-app.com

  cloudProvider:
    type: local
    annotations: {}

secrets:
  cloudflareToken: {{ env "CLOUDFLARE_TOKEN" | quote }}

env:
  LOG_LEVEL: "-4"

gateway-helm:
  enabled: true
  config:
    envoyGateway:
      logging:
        default: info
      telemetry:
        metrics:
          prometheus:
            disable: true
          sinks:
            - type: OpenTelemetry
              openTelemetry:
                host: otel-col-deploy.observability.svc.cluster.local
                port: 4317
                protocol: grpc
