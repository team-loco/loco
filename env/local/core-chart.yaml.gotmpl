certManager:
  issuer:
    email: {{ env "CERT_MANAGER_EMAIL" | default "dev@example.com" | quote }}

global:
  domain:
    apps:
      - onloco.app
      - onloco.build
    platform: loco.build

  cloudProvider:
    type: local
    annotations: {}
    {{- $lbRange := exec "mise" (list "run" "--quiet" "cluster:lb-range") | trim | splitList " " }}
    loadBalancerIPPool:
      start: {{ index $lbRange 0 | quote }}
      stop: {{ index $lbRange 1 | quote }}

secrets:
  cloudflareToken: {{ env "CLOUDFLARE_TOKEN" | quote }}

env:
  LOG_LEVEL: "-4"

gateway-helm:
  enabled: true
  config:
    envoyGateway:
      logging:
        default: info
      telemetry:
        metrics:
          prometheus:
            disable: true
          sinks:
            - type: OpenTelemetry
              openTelemetry:
                host: otel-col-deploy.observability.svc.cluster.local
                port: 4317
                protocol: grpc
