cilium:
  enabled: true
  rollOutCiliumPods: true
  kubeProxyReplacement: true
  k8sServiceHost: {{ requiredEnv "KIND_API_SERVER_IP" }}
  k8sServicePort: "6443"
  ipam:
    mode: kubernetes
  bpf:
    hostLegacyRouting: true
    masquerade: false
  l2announcements:
    enabled: true
  k8sClientRateLimit:
    qps: 10
    burst: 20
