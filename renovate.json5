{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  timezone: "America/Los_Angeles",
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency Dashboard",
  labels: ["dependencies"],
  prConcurrentLimit: 50,
  prHourlyLimit: 0,
  rebaseWhen: "conflicted",
  platformCommit: "enabled",
  ignorePaths: ["examples/**", "**/node_modules/**", "gen/ts/node_modules/**"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  constraints: {
    mise: "2026.11.5",
  },
  pep723: {
    managerFilePatterns: ["/^\\.agents/skills/.+\\.py$/"],
  },
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
  },
  lockFileMaintenance: {
    enabled: true,
    description: "Moves the transitive versions in bun.lock and uv.lock, which no package file update reaches. The default schedule, before 4am on Monday, never matches renovate.yml's Monday 06:00 run",
    schedule: ["at any time"],
  },
  packageRules: [
    {
      description: "The jdx/mise regex manager below moves the constraints.mise value with the CI mise version; Renovate's own tool-constraint update duplicates it with a v prefix",
      matchDepTypes: ["tool-constraint"],
      enabled: false,
    },
    {
      description: "The mise version is bumped by the jdx/mise regex rule below, which moves every copy together",
      matchManagers: ["github-actions"],
      matchDepNames: ["jdx/mise"],
      enabled: false,
    },
    {
      matchDepNames: ["github.com/team-loco/loco", "github.com/team-loco/loco/k8sapi"],
      enabled: false,
    },
    {
      groupName: "kubernetes",
      matchDatasources: ["go"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
    },
    {
      description: "The Gateway API CRDs a cluster runs come from the gateway-helm chart (mise run crds:apply), so the Go types move only with it. gateway-helm 1.10.x ships the v1.6 CRDs; raise allowedVersions in the gateway-helm update that ships a newer bundle",
      groupName: "gateway api",
      matchDepNames: ["sigs.k8s.io/gateway-api", "gateway-helm"],
    },
    {
      matchDatasources: ["go"],
      matchDepNames: ["sigs.k8s.io/gateway-api"],
      allowedVersions: "<1.7.0",
    },
    {
      description: "api reaches the Kubernetes libraries only through its replace of k8sapi, so its indirect entries move with the group",
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      enabled: true,
    },
    {
      description: "The other modules reach the root module's requirements through its replace, so their indirect entries move with the root module's direct ones; otherwise their go.sum lacks the new version and the build fails",
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      matchPackageNames: [
        "buf.build/gen/go/bufbuild/protovalidate/**",
        "github.com/go-jose/go-jose/**",
        "github.com/google/uuid",
        "github.com/santhosh-tekuri/jsonschema/**",
        "github.com/stretchr/testify",
        "go.yaml.in/yaml/**",
      ],
      enabled: true,
    },
    {
      description: "k8s.io/apimachinery pins kube-openapi and structured-merge-diff to the commits and major versions it builds against; a newer one on its own breaks the build (#436, #1312), so they move only with a Kubernetes release",
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      matchUpdateTypes: ["digest", "major"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      enabled: false,
    },
    {
      groupName: "connectrpc",
      matchDatasources: ["go"],
      matchPackageNames: ["connectrpc.com/**"],
    },
    {
      groupName: "golang.org/x",
      matchDatasources: ["go"],
      matchPackageNames: ["golang.org/x/**"],
    },
    {
      description: "The collector core modules and the contrib ClickHouse exporter release in lockstep. go.opentelemetry.io/otel versions on its own and stays out",
      groupName: "opentelemetry collector",
      matchDatasources: ["go"],
      matchPackageNames: ["go.opentelemetry.io/collector/**", "github.com/open-telemetry/opentelemetry-collector-contrib/**"],
    },
    {
      groupName: "charmbracelet",
      matchDatasources: ["go"],
      matchPackageNames: ["charm.land/**"],
    },
    {
      groupName: "opentelemetry charts",
      matchManagers: ["helmv3"],
      matchPackageNames: ["opentelemetry-**"],
    },
    {
      description: "A chart publishes only when its version moves, and lint:charts requires the bump. Only helmv3 can bump it: helm-values cannot, so an image update in a chart's values.yaml needs the chart version moved by hand",
      matchManagers: ["helmv3"],
      matchFileNames: ["charts/**"],
      bumpVersion: "patch",
    },
    {
      matchManagers: ["dockerfile", "docker-compose"],
      pinDigests: true,
    },
    {
      description: "Container images a workflow runs, such as the test job's service containers",
      matchManagers: ["github-actions"],
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      groupName: "go toolchain",
      matchManagers: ["mise", "dockerfile", "gomod"],
      matchDepNames: ["go", "golang"],
    },
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
    },
    {
      description: "The bun manager reads no locked versions from bun.lock, so the default update-lockfile strategy never finds an update inside a range; bump raises the range and regenerates bun.lock",
      matchManagers: ["bun"],
      rangeStrategy: "bump",
    },
    {
      description: "bunfig.toml blocks packages younger than this, so the bun install in an update PR fails on a newer release; lint:versions keeps the two equal",
      matchManagers: ["bun"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Lock file maintenance has no release timestamp, so the stability-days check never passes; bunfig.toml's minimumReleaseAge still applies when bun regenerates bun.lock",
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      groupName: "javascript",
      matchManagers: ["bun"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: "The protoc plugins stamp their version into gen/ts, so their PR needs mise run gen; the runtimes move with them and the rest of the JavaScript group does not wait on it",
      groupName: "protobuf-es",
      matchManagers: ["bun"],
      matchPackageNames: ["@bufbuild/**", "@connectrpc/**"],
    },
    {
      description: "typescript-eslint supports typescript <6.1.0 and crashes on TypeScript 7, which has no compiler API yet (typescript-eslint/typescript-eslint#10940); web type checks run through bun check",
      matchManagers: ["bun"],
      matchDepNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      groupName: "bun",
      matchManagers: ["mise", "dockerfile"],
      matchDepNames: ["bun", "oven/bun"],
    },
    {
      groupName: "uv",
      matchManagers: ["mise", "dockerfile"],
      matchDepNames: ["uv", "ghcr.io/astral-sh/uv"],
    },
    {
      description: "One PR moves mise.toml, mise.lock, the docs-builder image and the docs requires-python with uv.lock together",
      groupName: "python",
      matchManagers: ["mise", "dockerfile", "pep621"],
      matchDepNames: ["python"],
    },
    {
      description: "mise.lock and the docs-builder image need a python-build-standalone build and an official python image, which appear days after the CPython tag that mise reads. Docker Hub tags carry no release timestamp, so the age check applies to mise and pep621 only",
      matchManagers: ["mise", "pep621"],
      matchDepNames: ["python"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Python 3.15: pyyaml 6.0.3, a docs dependency, has no cp315 wheels",
      matchManagers: ["mise", "dockerfile", "pep621"],
      matchDepNames: ["python"],
      allowedVersions: "!/^3\\.15\\./",
    },
    {
      groupName: "github actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Infisical and the github: backend tools tag their releases with a v prefix. Renovate passes the tag to mise lock, which then writes it into mise.toml",
      matchManagers: ["mise"],
      matchDepNames: ["infisical", "/^github:/"],
      extractVersion: "^v?(?<version>.*)$",
    },
    {
      description: "A github: tool can publish its release assets after the tag, and mise lock fails until they reach it: infisical 0.45.0 had none an hour after its tag. One lock error aborts the whole Renovate run, lock file maintenance included",
      matchManagers: ["mise"],
      matchDepNames: ["infisical", "/^github:/"],
      minimumReleaseAge: "1 day",
    },
    {
      description: "One PR moves a postgres image in the compose files and the workflows together",
      groupName: "postgres",
      matchDepNames: ["postgres"],
    },
    {
      description: "kind's default node image sets the local Kubernetes version, and kubectl must stay within one minor version of it",
      groupName: "kind and kubectl",
      matchDepNames: ["kind", "kubectl"],
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "The API docs load Scalar from the CDN without bundling it. Renovate cannot recompute the script's integrity hash, so lint:sri fails the update until mise run fix:sri refreshes it",
      managerFilePatterns: ["/^api/docs\\.html$/"],
      matchStrings: ["https://cdn\\.jsdelivr\\.net/npm/(?<depName>@scalar/api-reference)@(?<currentValue>[^/]+)/"],
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      description: "mise: the version CI and Renovate run move together. min_version in mise.toml is the oldest mise that reads mise.lock and moves by hand.",
      managerFilePatterns: ["/^\\.github/actions/setup-tools/action\\.yml$/", "/^renovate\\.json5$/"],
      matchStrings: ["version: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n", "mise: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
      versioningTemplate: "loose",
    },
    {
      customType: "regex",
      description: "A version a Dockerfile or Makefile pins outside a FROM line, annotated with the dependency it tracks",
      managerFilePatterns: ["/(^|/)Dockerfile$/", "/(^|/)Makefile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n(?:ARG )?[A-Z0-9_]+_VERSION ?\\??= ?(?<currentValue>\\S+)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
    {
      customType: "regex",
      description: "cert-manager, the one chart installed straight from its repository rather than as a chart dependency",
      managerFilePatterns: ["/^charts/cert-manager\\.yaml$/"],
      matchStrings: ["repository: (?<registryUrl>\\S+)\\nchart: (?<depName>\\S+)\\nversion: (?<currentValue>\\S+)"],
      datasourceTemplate: "helm",
    },
  ],
}
