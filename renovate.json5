{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "America/Los_Angeles",
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency Dashboard",
  labels: ["dependencies"],
  prConcurrentLimit: 8,
  prHourlyLimit: 0,
  rebaseWhen: "conflicted",
  ignorePaths: ["examples/**", "**/node_modules/**", "gen/ts/node_modules/**"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
  },
  packageRules: [
    {
      matchDepNames: ["github.com/team-loco/loco/gen/go", "github.com/team-loco/loco/k8sapi"],
      enabled: false,
    },
    {
      groupName: "kubernetes",
      matchDatasources: ["go"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
    },
    {
      groupName: "connectrpc",
      matchDatasources: ["go"],
      matchPackageNames: ["connectrpc.com/**"],
    },
    {
      groupName: "golang.org/x",
      matchDatasources: ["go"],
      matchPackageNames: ["golang.org/x/**"],
    },
    {
      groupName: "charmbracelet",
      matchDatasources: ["go"],
      matchPackageNames: ["charm.land/**"],
    },
    {
      groupName: "opentelemetry charts",
      matchManagers: ["helmv3"],
      matchPackageNames: ["opentelemetry-**"],
    },
    {
      matchManagers: ["dockerfile"],
      pinDigests: true,
    },
    {
      groupName: "github actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "mise: the CI pin and the minimum version in mise.toml move together",
      managerFilePatterns: ["/^mise\\.toml$/", "/^\\.github/actions/setup-tools/action\\.yml$/"],
      matchStrings: ["min_version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"", "version: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"],
      depNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
      versioningTemplate: "loose",
    },
    {
      customType: "regex",
      description: "DOKS control plane version pinned in terraform",
      managerFilePatterns: ["/^terraform/do/kube\\.tf$/"],
      matchStrings: ["version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+-do\\.\\d+)\""],
      depNameTemplate: "digitalocean/doks",
      datasourceTemplate: "custom.doks",
    },
  ],
  customDatasources: {
    doks: {
      defaultRegistryUrlTemplate: "https://api.digitalocean.com/v2/kubernetes/options",
      format: "json",
      transformTemplates: [
        '{"releases": [{"version": $.options.versions[0].slug}], "sourceUrl": "https://docs.digitalocean.com/products/kubernetes/details/changelog/"}',
      ],
    },
  },
}
