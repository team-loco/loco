{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  timezone: "America/Los_Angeles",
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency Dashboard",
  labels: ["dependencies"],
  prConcurrentLimit: 8,
  prHourlyLimit: 0,
  rebaseWhen: "conflicted",
  platformCommit: "enabled",
  ignorePaths: ["examples/**", "**/node_modules/**", "gen/ts/node_modules/**"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  constraints: {
    mise: "2026.10.15",
  },
  pep723: {
    managerFilePatterns: ["/^\\.agents/skills/.+\\.py$/"],
  },
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
  },
  packageRules: [
    {
      description: "The jdx/mise regex manager below moves the constraints.mise value with the CI mise version; Renovate's own tool-constraint update duplicates it with a v prefix",
      matchDepTypes: ["tool-constraint"],
      enabled: false,
    },
    {
      description: "The mise version is bumped by the jdx/mise regex rule below, which moves every copy together",
      matchManagers: ["github-actions"],
      matchDepNames: ["jdx/mise"],
      enabled: false,
    },
    {
      matchDepNames: ["github.com/team-loco/loco", "github.com/team-loco/loco/k8sapi"],
      enabled: false,
    },
    {
      groupName: "kubernetes",
      matchDatasources: ["go"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
    },
    {
      description: "api reaches the Kubernetes libraries only through its replace of k8sapi, so its indirect entries move with the group",
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      enabled: true,
    },
    {
      description: "k8s.io/apimachinery pins kube-openapi and structured-merge-diff to the commits it builds against; a newer commit on its own breaks the build (#436), so they move only with a Kubernetes release",
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      enabled: false,
    },
    {
      groupName: "connectrpc",
      matchDatasources: ["go"],
      matchPackageNames: ["connectrpc.com/**"],
    },
    {
      groupName: "golang.org/x",
      matchDatasources: ["go"],
      matchPackageNames: ["golang.org/x/**"],
    },
    {
      groupName: "charmbracelet",
      matchDatasources: ["go"],
      matchPackageNames: ["charm.land/**"],
    },
    {
      groupName: "opentelemetry charts",
      matchManagers: ["helmv3"],
      matchPackageNames: ["opentelemetry-**"],
    },
    {
      description: "A chart publishes only when its version moves, and lint:chart-versions requires the bump",
      matchManagers: ["helmv3", "helm-values"],
      matchFileNames: ["charts/**"],
      bumpVersion: "patch",
    },
    {
      matchManagers: ["dockerfile", "docker-compose"],
      pinDigests: true,
    },
    {
      description: "Container images a workflow runs, such as the test job's service containers",
      matchManagers: ["github-actions"],
      matchDatasources: ["docker"],
      pinDigests: true,
    },
    {
      groupName: "go toolchain",
      matchManagers: ["mise", "dockerfile", "gomod"],
      matchDepNames: ["go", "golang"],
    },
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
    },
    {
      description: "The bun manager reads no locked versions from bun.lock, so the default update-lockfile strategy never finds an update inside a range; bump raises the range and regenerates bun.lock",
      matchManagers: ["bun"],
      rangeStrategy: "bump",
    },
    {
      description: "bunfig.toml blocks packages younger than this, so the bun install in an update PR fails on a newer release; lint:versions keeps the two equal",
      matchManagers: ["bun"],
      minimumReleaseAge: "3 days",
    },
    {
      groupName: "javascript",
      matchManagers: ["bun"],
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: "The protoc plugins stamp their version into gen/ts, so their PR needs mise run gen; the runtimes move with them and the rest of the JavaScript group does not wait on it",
      groupName: "protobuf-es",
      matchManagers: ["bun"],
      matchPackageNames: ["@bufbuild/**", "@connectrpc/**"],
    },
    {
      groupName: "bun",
      matchManagers: ["mise", "dockerfile"],
      matchDepNames: ["bun", "oven/bun"],
    },
    {
      groupName: "uv",
      matchManagers: ["mise", "dockerfile"],
      matchDepNames: ["uv", "ghcr.io/astral-sh/uv"],
    },
    {
      description: "One PR moves mise.toml, mise.lock, the docs-builder image and the docs requires-python with uv.lock together",
      groupName: "python",
      matchManagers: ["mise", "dockerfile", "pep621"],
      matchDepNames: ["python"],
    },
    {
      description: "mise.lock and the docs-builder image need a python-build-standalone build and an official python image, which appear days after the CPython tag that mise reads. Docker Hub tags carry no release timestamp, so the age check applies to mise and pep621 only",
      matchManagers: ["mise", "pep621"],
      matchDepNames: ["python"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Python 3.15: pyyaml 6.0.3, a docs dependency, has no cp315 wheels",
      matchManagers: ["mise", "dockerfile", "pep621"],
      matchDepNames: ["python"],
      allowedVersions: "!/^3\\.15\\./",
    },
    {
      groupName: "github actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "kind's default node image sets the local Kubernetes version, and kubectl must stay within one minor version of it",
      groupName: "kind and kubectl",
      matchDepNames: ["kind", "kubectl"],
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "mise: the version CI and Renovate run move together. min_version in mise.toml is the oldest mise that reads mise.lock and moves by hand.",
      managerFilePatterns: ["/^\\.github/actions/setup-tools/action\\.yml$/", "/^renovate\\.json5$/"],
      matchStrings: ["version: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n", "mise: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
      versioningTemplate: "loose",
    },
    {
      customType: "regex",
      description: "A version a Dockerfile or Makefile pins outside a FROM line, annotated with the dependency it tracks",
      managerFilePatterns: ["/(^|/)Dockerfile$/", "/(^|/)Makefile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n(?:ARG )?[A-Z0-9_]+_VERSION ?\\??= ?(?<currentValue>\\S+)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
    {
      customType: "regex",
      description: "cert-manager, the one chart installed straight from its repository rather than as a chart dependency",
      managerFilePatterns: ["/^charts/cert-manager\\.yaml$/"],
      matchStrings: ["repository: (?<registryUrl>\\S+)\\nchart: (?<depName>\\S+)\\nversion: (?<currentValue>\\S+)"],
      datasourceTemplate: "helm",
    },
  ],
}
