# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# env file
.env

# temp
*/tmp/*
tmp/*
**/bin/**

# local certs and keys
*.pem
*.agekey

# IDE specific files
settings.json

# scratch files
*.log
secrets.md
# Design/TDD docs, anchored: web/src/components/design/ is tracked.
/design/
docs/design/

# JS dependencies. bun workspaces hoist to the repo root, so this must be
# unanchored to cover ./node_modules, web/node_modules and gen/ts/node_modules.
node_modules/

# Mac
.DS_Store

# LLM Stuff
CLAUDE.local.md
.claude/*
!.claude/skills
!.claude/agents

# local helm charts and values
**/values/local.yaml
charts/loco-*/charts/
charts/loco-control-plane/telemetry/charts/
**/dist/**

# e2e test artifacts
tests/e2e/runs/
tests/ui/out/

.agents/troubles/

__pycache__/
.pytest_cache/
.venv/
