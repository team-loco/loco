# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# temp
*/tmp/*
tmp/*
**/bin/**

# terraform
*.tfstate
terraform/.terraform/*

# local certs and keys
*.pem
*.agekey

# IDE specific files
settings.json

# scratch files
*.log
.archive/**
scratch.txt
secrets.md
# Design/TDD docs. These must stay anchored: a bare `design/` matches at any
# depth and silently swallowed web/src/components/design/, keeping the whole
# UI design system out of the repo.
/design/
docs/design/

# JS dependencies. bun workspaces hoist to the repo root, so this must be
# unanchored to cover ./node_modules, web/node_modules and gen/ts/node_modules.
node_modules/

# Mac
.DS_Store

# LLM Stuff
AGENTS.md

# local helm charts and values
**/values/local.yaml
charts/loco-*/charts/
env/local/
env/local-controller.yaml.gotmpl

# full helm chart references.
references/
**/dist/**

lint.html
seed.sql

# e2e test artifacts
e2e/pids/
e2e/logs/




# temp ignores
.sops.yaml
v1-report.html
CLAUDE.md
clusters/
.github/workflows/deploy-production.yml
.github/workflows/deploy-staging.yml