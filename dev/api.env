APP_PORT=:8000
LOG_LEVEL=debug
DATABASE_URL=postgres://loco_user:loco_password@localhost:5432/loco?sslmode=disable
CACHE_TYPE=valkey
CACHE_ADDR=valkey://127.0.0.1:6379
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173
AUTH_ISSUERS='[{"issuer":"http://localhost:5556/dex","audience":"loco","emailVerification":"claim","web":{"clientId":"loco","scopes":"openid email profile offline_access"}}]'
LOCO_BOOTSTRAP_TOKEN=loco-local-bootstrap-token-0123456789abcdef
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

LOCO_REGISTRY_HOST=loco-registry:5000
LOCO_REGISTRY_URL=http://localhost:5001
LOCO_REGISTRY_USERNAME=api
LOCO_REGISTRY_PASSWORD=loco-dev-api

LOCO_SOURCE_BUCKET_ENDPOINT=http://loco-s3.localhost:9000
LOCO_SOURCE_BUCKET=loco-sources
LOCO_SOURCE_BUCKET_REGION=us-east-1
LOCO_SOURCE_BUCKET_ACCESS_KEY_ID=loco-dev
LOCO_SOURCE_BUCKET_SECRET_ACCESS_KEY=loco-dev-secret
LOCO_SOURCE_BUCKET_FORCE_PATH_STYLE=true

LOCO_SECRETS_TRANSIT_ADDR=http://localhost:8201
LOCO_SECRETS_TRANSIT_MOUNT=transit
LOCO_SECRETS_TRANSIT_KEY=loco
LOCO_SECRETS_TRANSIT_AUTH=token
LOCO_SECRETS_TRANSIT_TOKEN=loco-dev-transit-token
LOCO_INGEST_TRANSIT_KEY=loco-ingest
