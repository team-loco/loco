---
environments:
  local:
    values:
      - env/global.yaml
      - installCNI: true

  prod:
    values:
      - env/global.yaml
      - installCNI: false
---
helmDefaults:
  wait: false
  timeout: 600
  cleanupOnFail: true

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: cilium
    url: https://helm.cilium.io
  - name: altinity
    url: https://helm.altinity.com
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts

releases:
{{- if .Values.installCNI }}
  # phase 1: networking
  - name: loco-networking
    chart: ./charts/loco-networking
    namespace: kube-system
    createNamespace: true
    labels:
      phase: "1-networking"
    values:
      - ./charts/loco-networking/values.yaml
      - env/{{ .Environment.Name }}/networking-chart.yaml.gotmpl
{{- end }}

  - name: loco-namespaces
    chart: ./manifests/namespaces
    namespace: kube-system
    labels:
      phase: "2-core"

  - name: cert-manager
    chart: jetstack/cert-manager
    version: v1.21.2
    namespace: cert-manager
    createNamespace: true
{{- if .Values.installCNI }}
    needs:
      - kube-system/loco-networking
{{- end }}
    labels:
      phase: "2-core"
    set:
      - name: crds.enabled
        value: true

  - name: loco-core
    chart: ./charts/loco-core
    namespace: loco-system
    createNamespace: false
    needs:
      - kube-system/loco-namespaces
      - cert-manager/cert-manager
      - loco-system/loco-operator
    labels:
      phase: "2-core"
      component: "app"
    values:
      - ./charts/loco-core/values.yaml
      - env/{{ .Environment.Name }}/core-chart.yaml.gotmpl

  - name: loco-operator
    chart: ./charts/loco-operator
    namespace: loco-system
    createNamespace: false
    needs:
      - kube-system/loco-namespaces
{{- if .Values.installCNI }}
      - kube-system/loco-networking
{{- end }}
    labels:
      phase: "2-core"
      component: "loco-operator"
    values:
      - ./charts/loco-operator/values.yaml
      - env/{{ .Environment.Name }}/operator-chart.yaml.gotmpl


  # phase 3: observability
  - name: loco-obs
    chart: ./charts/loco-obs
    namespace: observability
    createNamespace: false
    needs:
      - kube-system/loco-namespaces
      - loco-system/loco-core
    labels:
      phase: "3-observability"
    values:
      - ./charts/loco-obs/values.yaml
      - env/{{ .Environment.Name }}/obs-chart.yaml.gotmpl

